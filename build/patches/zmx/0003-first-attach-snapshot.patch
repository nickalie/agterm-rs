+test "an attaching client ends in the daemon's state whatever sequence the attach cut" {
+    for ([_]bool{ false, true }) |reattach| {
+        // nothing in flight
+        try expectAttachConverges("READY$ ", "", "ls\r\n", reattach);
+        // a CSI, an OSC, a DCS, an APC and a UTF-8 character cut before the connect
+        try expectAttachConverges("plain \x1b[3", "", "1mRED\x1b[0m $ ", reattach);
+        try expectAttachConverges("\x1b]2;my ti", "", "tle\x07READY $ ", reattach);
+        try expectAttachConverges("dcs \x1bP$q", "", "m\x1b\\ $ ", reattach);
+        try expectAttachConverges("apc \x1b_Ga=d,", "", "d=A\x1b\\ $ ", reattach);
+        try expectAttachConverges("price \xe2\x82", "", "\xac $ ", reattach);
+    }
+    // a first attach also sent output between its connect and its Init, ending inside a CSI, a UTF-8 character, an
+    // OSC, a DCS and an APC (the reset's ESC dispatches a cut string early; the end state still converges)
+    try expectAttachConverges("lost line\r\n", "seen \x1b[3", "2mGREEN\x1b[0m $ ", false);
+    try expectAttachConverges("lost line\r\n", "seen \xe2", "\x82\xac $ ", false);
+    try expectAttachConverges("lost line\r\n", "seen \x1b]2;par", "tial\x07 $ ", false);
+    try expectAttachConverges("lost line\r\n", "seen \x1bP$q", "m\x1b\\ $ ", false);
+    try expectAttachConverges("lost line\r\n", "seen \x1b_Ga=d,", "d=A\x1b\\ $ ", false);
+    // the cut sequence began before the connect and continues across it
+    try expectAttachConverges("lost \x1b[1;", "3", "4mBLUE\x1b[0m $ ", false);
+}
