+test "the first attach is sent what the program wrote before it connected" {
+    const alloc = std.testing.allocator;
+    const cfg = Cfg{ .socket_dir = "", .log_dir = "" };
+    var term = try initTerminal(alloc, std.testing.io, .{ .cols = 80, .rows = 24 }, &cfg);
+    defer term.deinit(alloc);
+    var stream = continuationStream(&term);
+    defer stream.deinit();
+    var daemon = testDaemon();
+    daemon.vt_stream = &stream;
+    defer daemon.clients.deinit(alloc);
+    defer daemon.pty_write_buf.deinit(alloc);
+
+    const a = try lib_posix.pipe2(.{});
+    const b = try lib_posix.pipe2(.{});
+    defer lib_posix.close(b[1]);
+    const pty = b[0];
+    defer lib_posix.close(pty);
+    const size = std.mem.asBytes(&ipc.Resize{ .rows = 24, .cols = 80 });
+
+    // a program with nothing written yet: the first attach is sent nothing
+    const quiet = try testClient(alloc, a[0], false);
+    try daemon.clients.append(alloc, quiet);
+    try daemon.handleInit(alloc, quiet, pty, &term, size);
+    const nothing = try queuedOutput(alloc, quiet);
+    defer alloc.free(nothing);
+    try std.testing.expectEqualStrings("", nothing);
+    _ = daemon.closeClient(alloc, quiet, 0, false);
+
+    // the prompt went out before any client connected
+    daemon.has_had_client = false;
+    stream.nextSlice("READY$ ");
+    daemon.has_pty_output = true;
+    const first = try testClient(alloc, a[1], false);
+    try daemon.clients.append(alloc, first);
+    try daemon.handleInit(alloc, first, pty, &term, size);
+    const replay = try queuedOutput(alloc, first);
+    defer alloc.free(replay);
+    try std.testing.expect(std.mem.startsWith(u8, replay, FIRST_ATTACH_RESET));
+    try std.testing.expect(std.mem.indexOf(u8, replay, "READY$ ") != null);
+    try std.testing.expect(daemon.has_had_client);
+    _ = daemon.closeClient(alloc, first, 0, false);
+
+    // a re-attach keeps its plain snapshot
+    const c = try lib_posix.pipe2(.{});
+    defer lib_posix.close(c[1]);
+    const again = try testClient(alloc, c[0], false);
+    try daemon.clients.append(alloc, again);
+    try daemon.handleInit(alloc, again, pty, &term, size);
+    const snapshot = try queuedOutput(alloc, again);
+    defer alloc.free(snapshot);
+    try std.testing.expect(!std.mem.startsWith(u8, snapshot, FIRST_ATTACH_RESET));
+    try std.testing.expect(std.mem.indexOf(u8, snapshot, "READY$ ") != null);
+    _ = daemon.closeClient(alloc, again, 0, false);
+}
