+/// The daemon's parser over `term`, tracking the unfinished sequence a PTY read
+/// may end in, so a snapshot can hand it on (`Daemon.queueSnapshot`); the limit
+/// is the one libghostty's own snapshots use.
+fn continuationStream(term: *ghostty_vt.Terminal) ghostty_vt.TerminalStream {
+    return ghostty_vt.TerminalStream.init(.{
+        .allocator = term.gpa(),
+        .handler = term.vtHandler(),
