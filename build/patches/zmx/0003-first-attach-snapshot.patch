+    /// Queue the terminal's state for an attaching `client`: a reset first when
+    /// it was already sent output (`ATTACH_RESET`: that output is in the
+    /// snapshot too), then the snapshot, then the unfinished sequence the
+    /// daemon's parser is in, so the client's parser continues the next output
+    /// where the daemon's does.
+    fn queueSnapshot(self: *Daemon, gpa: std.mem.Allocator, client: *Client, term: *ghostty_vt.Terminal) void {
+        if (client.sent_output) {
+            ipc.appendMessage(gpa, &client.write_buf, .Output, ATTACH_RESET) catch |err| {
+                std.log.warn("failed to buffer the attach reset for client err={s}", .{@errorName(err)});
+            };
+            client.has_pending_output = true;
+        }
+        const cursor = &term.screens.active.cursor;
+        std.log.debug(
