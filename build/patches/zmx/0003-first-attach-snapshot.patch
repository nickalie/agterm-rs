+/// One attach: the program writes `lost` before the client connects, `seen` between its connect and its Init
+/// (broadcast to it), and `after` once attached; `reattach` makes it a session a terminal was attached to before.
+/// The client's terminal must end exactly where the daemon's does: same screen, styles and title.
+fn expectAttachConverges(lost: []const u8, seen: []const u8, after: []const u8, reattach: bool) !void {
+    const alloc = std.testing.allocator;
+    const cfg = Cfg{ .socket_dir = "", .log_dir = "" };
+    var term = try initTerminal(alloc, std.testing.io, .{ .cols = 40, .rows = 6 }, &cfg);
+    defer term.deinit(alloc);
+    var stream = continuationStream(&term);
+    defer stream.deinit();
+    var client_term = try initTerminal(alloc, std.testing.io, .{ .cols = 40, .rows = 6 }, &cfg);
+    defer client_term.deinit(alloc);
+    var client_stream = client_term.vtStream();
+    defer client_stream.deinit();
+    var daemon = testDaemon();
+    daemon.vt_stream = &stream;
+    defer daemon.clients.deinit(alloc);
+    defer daemon.pty_write_buf.deinit(alloc);
+    const a = try lib_posix.pipe2(.{});
+    defer lib_posix.close(a[1]);
+    const b = try lib_posix.pipe2(.{});
+    defer lib_posix.close(b[1]);
+    defer lib_posix.close(b[0]);
+
+    stream.nextSlice(lost);
+    // what `zmx attach` writes before it connects
+    client_stream.nextSlice("\x1b[2J\x1b[H");
+    stream.nextSlice(seen);
+    client_stream.nextSlice(seen);
+    daemon.has_pty_output = lost.len + seen.len > 0;
+    daemon.has_had_client = reattach;
+    const client = try testClient(alloc, a[0], false);
+    try daemon.clients.append(alloc, client);
+    try daemon.handleInit(alloc, client, b[0], &term, std.mem.asBytes(&ipc.Resize{ .rows = 6, .cols = 40 }));
+    const replay = try queuedOutput(alloc, client);
+    defer alloc.free(replay);
+    client_stream.nextSlice(replay);
+    stream.nextSlice(after);
+    client_stream.nextSlice(after);
+
+    const want = util.serializeTerminal(alloc, &term, .vt) orelse return error.TestUnexpectedNull;
+    defer alloc.free(want);
+    const got = util.serializeTerminal(alloc, &client_term, .vt) orelse return error.TestUnexpectedNull;
+    defer alloc.free(got);
+    try std.testing.expectEqualStrings(want, got);
+    try std.testing.expectEqualStrings(term.getTitle() orelse "", client_term.getTitle() orelse "");
+    _ = daemon.closeClient(alloc, client, 0, false);
+}
+
+test "an attaching client ends in the daemon's state whatever sequence the attach cut" {
+    for ([_]bool{ false, true }) |reattach| {
+        // nothing in flight
+        try expectAttachConverges("READY$ ", "", "ls\r\n", reattach);
+        // a CSI, an OSC, a DCS, an APC and a UTF-8 character cut before the connect
+        try expectAttachConverges("plain \x1b[3", "", "1mRED\x1b[0m $ ", reattach);
+        try expectAttachConverges("\x1b]2;my ti", "", "tle\x07READY $ ", reattach);
+        try expectAttachConverges("dcs \x1bP$q", "", "m\x1b\\ $ ", reattach);
+        try expectAttachConverges("apc \x1b_Ga=d,", "", "d=A\x1b\\ $ ", reattach);
+        try expectAttachConverges("price \xe2\x82", "", "\xac $ ", reattach);
+    }
+    // a first attach also sent output between its connect and its Init, ending inside a CSI, a UTF-8 character, an
+    // OSC, a DCS and an APC (the reset's ESC dispatches a cut string early; the end state still converges)
+    try expectAttachConverges("lost line\r\n", "seen \x1b[3", "2mGREEN\x1b[0m $ ", false);
+    try expectAttachConverges("lost line\r\n", "seen \xe2", "\x82\xac $ ", false);
+    try expectAttachConverges("lost line\r\n", "seen \x1b]2;par", "tial\x07 $ ", false);
+    try expectAttachConverges("lost line\r\n", "seen \x1bP$q", "m\x1b\\ $ ", false);
+    try expectAttachConverges("lost line\r\n", "seen \x1b_Ga=d,", "d=A\x1b\\ $ ", false);
+    // the cut sequence began before the connect and continues across it
+    try expectAttachConverges("lost \x1b[1;", "3", "4mBLUE\x1b[0m $ ", false);
+}
