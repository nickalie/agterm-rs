+test "a client sent output before its Init ends as one that connected after it, first attach or re-attach" {
+    // The snapshot repeats what the broadcast sent, so the reset must leave no trace of it: the client ends exactly
+    // as one that was sent nothing before its Init. (Against the daemon itself the scrollback can differ: a
+    // snapshot's history rows that never scrolled off are erased by its own `ESC[2J`, a re-attach property of the
+    // serializer this does not change.)
+    const alloc = std.testing.allocator;
+    // more history than three screens, so the snapshot's history rows scroll into the client's scrollback
+    const history = "line 1\r\nline 2\r\nline 3\r\nline 4\r\nline 5\r\nline 6\r\nline 7\r\nline 8\r\nline 9\r\n" ++
+        "line 10\r\nline 11\r\nline 12\r\nline 13\r\nline 14\r\nline 15\r\nline 16\r\nline 17\r\nline 18\r\n" ++
+        "line 19\r\nline 20\r\n";
+    // a CSI, an OSC, a DCS, an APC and a UTF-8 character cut in the broadcast; origin mode in a scrolling region and
+    // the alternate screen entered by it
+    const cases = [_][2][]const u8{
+        .{ "seen \x1b[3", "2mGREEN\x1b[0m $ " },
+        .{ "seen \x1b]2;par", "tial\x07 $ " },
+        .{ "seen \x1bP$q", "m\x1b\\ $ " },
+        .{ "seen \x1b_Ga=d,", "d=A\x1b\\ $ " },
+        .{ "seen \xe2", "\x82\xac $ " },
+        .{ "\x1b[2;5r\x1b[?6hX", " $ " },
+        .{ "\x1b[?1049halt", " $ " },
+    };
+    for ([_]bool{ false, true }) |reattach| {
+        for (cases) |case| {
+            const clean = try attachedScreen(alloc, history, case[0], case[1], reattach, false);
+            defer alloc.free(clean);
+            const dirty = try attachedScreen(alloc, history, case[0], case[1], reattach, true);
+            defer alloc.free(dirty);
+            errdefer std.debug.print("case {any} reattach={}\n", .{ case[0], reattach });
+            try std.testing.expectEqualStrings(clean, dirty);
+        }
+    }
+}
