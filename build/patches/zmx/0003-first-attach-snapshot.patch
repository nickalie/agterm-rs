+/// The screen (with scrollback) and title of a client attaching to a daemon whose program wrote `lost` and then
+/// `seen`, and `after` once attached; with `broadcast` the client was already connected for `seen` (sent it between
+/// its connect and its Init), without it the client connected after it.
+fn attachedScreen(
+    alloc: std.mem.Allocator,
+    lost: []const u8,
+    seen: []const u8,
+    after: []const u8,
+    reattach: bool,
+    broadcast: bool,
+) ![]u8 {
+    const cfg = Cfg{ .socket_dir = "", .log_dir = "" };
+    var term = try initTerminal(alloc, std.testing.io, .{ .cols = 40, .rows = 6 }, &cfg);
+    defer term.deinit(alloc);
+    var stream = continuationStream(&term);
+    defer stream.deinit();
+    var client_term = try initTerminal(alloc, std.testing.io, .{ .cols = 40, .rows = 6 }, &cfg);
+    defer client_term.deinit(alloc);
+    var client_stream = client_term.vtStream();
+    defer client_stream.deinit();
+    var daemon = testDaemon();
+    daemon.vt_stream = &stream;
+    defer daemon.clients.deinit(alloc);
+    defer daemon.pty_write_buf.deinit(alloc);
+    const a = try lib_posix.pipe2(.{});
+    defer lib_posix.close(a[1]);
+    const b = try lib_posix.pipe2(.{});
+    defer lib_posix.close(b[1]);
+    defer lib_posix.close(b[0]);
+
+    stream.nextSlice(lost);
+    stream.nextSlice(seen);
+    // what `zmx attach` writes before it connects
+    client_stream.nextSlice("\x1b[2J\x1b[H");
+    if (broadcast) client_stream.nextSlice(seen);
+    daemon.has_pty_output = true;
+    daemon.has_had_client = reattach;
+    const client = try testClient(alloc, a[0], false);
+    client.sent_output = broadcast;
+    try daemon.clients.append(alloc, client);
+    defer _ = daemon.closeClient(alloc, client, 0, false);
+    try daemon.handleInit(alloc, client, b[0], &term, std.mem.asBytes(&ipc.Resize{ .rows = 6, .cols = 40 }));
+    const replay = try queuedOutput(alloc, client);
+    defer alloc.free(replay);
+    client_stream.nextSlice(replay);
+    stream.nextSlice(after);
+    client_stream.nextSlice(after);
+    const screen = util.serializeTerminal(alloc, &client_term, .vt) orelse return error.TestUnexpectedNull;
+    defer alloc.free(screen);
+    return std.fmt.allocPrint(alloc, "{s}\ntitle={s}", .{ screen, client_term.getTitle() orelse "" });
+}
