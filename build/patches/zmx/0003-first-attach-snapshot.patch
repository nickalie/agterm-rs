+    /// Queue the terminal's state for an attaching `client`: on a first attach
+    /// a reset first (`FIRST_ATTACH_RESET`: output it may have been sent
+    /// between its connect and its Init is in the snapshot too), then the
+    /// snapshot, then the unfinished sequence the daemon's parser is in, so the
+    /// client's parser continues the next output where the daemon's does.
+    fn queueSnapshot(self: *Daemon, gpa: std.mem.Allocator, client: *Client, term: *ghostty_vt.Terminal) void {
+        if (!self.has_had_client) {
+            ipc.appendMessage(gpa, &client.write_buf, .Output, FIRST_ATTACH_RESET) catch |err| {
+                std.log.warn("failed to buffer the first attach reset for client err={s}", .{@errorName(err)});
+            };
+            client.has_pending_output = true;
+        }
+        const cursor = &term.screens.active.cursor;
+        std.log.debug(
+            "cursor before serialize: x={d} y={d} pending_wrap={}",
+            .{ cursor.x, cursor.y, cursor.pending_wrap },
+        );
+        if (util.serializeTerminalState(gpa, term)) |term_output| {
+            std.log.debug("serialize terminal state", .{});
+            // Rewrite OSC 133;A to include redraw=0 so the outer terminal
+            // does not clear prompt lines on resize (issue #111).
+            const restore_data = util.rewritePromptRedraw(gpa, term_output) orelse term_output;
+            defer gpa.free(term_output);
+            defer if (restore_data.ptr != term_output.ptr) gpa.free(restore_data);
+            ipc.appendMessage(gpa, &client.write_buf, .Output, restore_data) catch |err| {
+                std.log.warn(
+                    "failed to buffer terminal state for client err={s}",
+                    .{@errorName(err)},
+                );
+            };
+            client.has_pending_output = true;
+        }
+        const stream = self.vt_stream orelse return;
+        if (stream.ground()) return;
+        var continuation: std.Io.Writer.Allocating = .init(gpa);
+        defer continuation.deinit();
+        stream.writeContinuation(&continuation.writer) catch |err| {
+            // longer than the tracker keeps, or its allocation failed: the
+            // rest of that sequence reaches the client without its start
+            std.log.warn("no continuation for the snapshot err={s}", .{@errorName(err)});
+            return;
+        };
+        ipc.appendMessage(gpa, &client.write_buf, .Output, continuation.writer.buffered()) catch |err| {
+            std.log.warn("failed to buffer the continuation for client err={s}", .{@errorName(err)});
+        };
+    }
