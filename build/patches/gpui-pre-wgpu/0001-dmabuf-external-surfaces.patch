diff -ruN a/src/external_surface/completion.rs b/src/external_surface/completion.rs
--- a/src/external_surface/completion.rs
+++ b/src/external_surface/completion.rs
@@ -0,0 +1,188 @@
+//! When the GPU finished a submission: a timeline semaphore of the renderer's own, signalled by each submission that
+//! copies or first draws an external frame (wgpu-hal's `add_signal_semaphore`), read for retiring imported images and
+//! waited on by a thread that reports frames. The thread waits with `vkWaitSemaphores`, outside every wgpu lock:
+//! `Device::poll` holds the device's fence lock while it waits, which would stall the next `Queue::submit`.
+
+use super::Callback;
+use anyhow::{Context as _, Result, bail};
+use ash::vk;
+use gpui::FrameOutcome;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::mpsc;
+use std::time::{Duration, Instant};
+use wgpu::hal::vulkan;
+
+/// How long a wait goes on before it is logged, and how long a shutdown waits for submissions still running.
+const PATIENCE: Duration = Duration::from_secs(10);
+
+/// The renderer's timeline semaphore and the thread reporting frames once the GPU reached their value.
+pub(super) struct Timeline {
+    semaphore: vk::Semaphore,
+    raw: ash::Device,
+    /// The value the last signalling submission was given.
+    last: u64,
+    sender: Option<mpsc::Sender<(u64, Vec<Callback>)>>,
+    thread: Option<std::thread::JoinHandle<()>>,
+    shutdown: Arc<AtomicBool>,
+    /// Keeps the device (and so `raw` and `semaphore`) alive until the thread ended.
+    _device: wgpu::Device,
+}
+
+impl Timeline {
+    /// A timeline on `device`; an error on a device that is not Vulkan or cannot make one.
+    pub(super) fn new(device: &wgpu::Device) -> Result<Self> {
+        let raw = {
+            // SAFETY: the guard is dropped at the end of this block; the ash device it hands out stays valid while
+            // `device` lives, which this value keeps.
+            let hal_device = unsafe { device.as_hal::<vulkan::Api>() }.context("the device is not Vulkan")?;
+            hal_device.raw_device().clone()
+        };
+        let mut timeline = vk::SemaphoreTypeCreateInfo::default()
+            .semaphore_type(vk::SemaphoreType::TIMELINE)
+            .initial_value(0);
+        // SAFETY: the device was opened with Vulkan 1.2 and the timeline semaphore feature (`missing_requirements`).
+        let semaphore = unsafe {
+            raw.create_semaphore(&vk::SemaphoreCreateInfo::default().push_next(&mut timeline), None)
+        }
+        .context("vkCreateSemaphore (timeline)")?;
+        let (sender, receiver) = mpsc::channel::<(u64, Vec<Callback>)>();
+        let shutdown = Arc::new(AtomicBool::new(false));
+        let waiter = raw.clone();
+        let stopping = Arc::clone(&shutdown);
+        let thread = std::thread::Builder::new()
+            .name("gpui-external-surfaces".to_owned())
+            .spawn(move || report(&waiter, semaphore, &receiver, &stopping));
+        let thread = match thread {
+            Ok(thread) => thread,
+            Err(error) => {
+                // SAFETY: the semaphore was created above and nothing waits on or signals it.
+                unsafe { raw.destroy_semaphore(semaphore, None) };
+                bail!("the completion thread did not start: {error}");
+            }
+        };
+        Ok(Self {
+            semaphore,
+            raw,
+            last: 0,
+            sender: Some(sender),
+            thread: Some(thread),
+            shutdown,
+            _device: device.clone(),
+        })
+    }
+
+    /// Has the next submission on `queue` signal a new value, which it returns.
+    pub(super) fn signal(&mut self, queue: &wgpu::Queue) -> Option<u64> {
+        // SAFETY: the guard is only used to queue the signal and is dropped before the submission.
+        let hal_queue = unsafe { queue.as_hal::<vulkan::Api>() }?;
+        self.last += 1;
+        hal_queue.add_signal_semaphore(self.semaphore, Some(self.last));
+        Some(self.last)
+    }
+
+    /// Reports `callbacks` once the GPU reached `value`.
+    pub(super) fn complete_at(&self, value: u64, callbacks: Vec<Callback>) {
+        if callbacks.is_empty() {
+            return;
+        }
+        if let Some(sender) = &self.sender
+            && let Err(mpsc::SendError((_, callbacks))) = sender.send((value, callbacks))
+        {
+            for callback in callbacks {
+                callback(FrameOutcome::Lost("the completion thread ended".to_owned()));
+            }
+        }
+    }
+
+    /// The value the GPU has reached (0 when it cannot be read).
+    pub(super) fn reached(&self) -> u64 {
+        // SAFETY: the semaphore is a timeline semaphore of this device, alive while `self` is.
+        unsafe { self.raw.get_semaphore_counter_value(self.semaphore) }.unwrap_or(0)
+    }
+
+    /// Waits, a bounded while, until the GPU reached every value signalled so far; whether it did.
+    pub(super) fn settle(&self) -> bool {
+        let semaphores = [self.semaphore];
+        let values = [self.last];
+        let info = vk::SemaphoreWaitInfo::default().semaphores(&semaphores).values(&values);
+        // SAFETY: the semaphore and device are alive while `self` is; waiting needs no external synchronization.
+        unsafe { self.raw.wait_semaphores(&info, PATIENCE.as_nanos() as u64) }.is_ok()
+    }
+}
+
+impl Drop for Timeline {
+    fn drop(&mut self) {
+        self.shutdown.store(true, Ordering::Relaxed);
+        self.sender = None;
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+        if self.reached() >= self.last {
+            // SAFETY: the GPU reached every value any submission signals, so no queue operation refers to the
+            // semaphore any more, and the thread that waited on it has ended.
+            unsafe { self.raw.destroy_semaphore(self.semaphore, None) };
+        } else {
+            log::warn!("external surfaces: a submission never finished; its timeline semaphore is leaked");
+        }
+    }
+}
+
+/// The completion thread: for each batch in order, waits until the GPU reached its value and reports its frames:
+/// `Presented`, or `Lost` when the device was lost or a shutdown gave up waiting.
+fn report(
+    raw: &ash::Device,
+    semaphore: vk::Semaphore,
+    receiver: &mpsc::Receiver<(u64, Vec<Callback>)>,
+    shutdown: &AtomicBool,
+) {
+    // One shutdown deadline for the whole thread, so a stalled GPU delays a teardown by PATIENCE, not per batch.
+    let mut shutdown_since: Option<Instant> = None;
+    for (value, callbacks) in receiver {
+        let outcome = match wait_value(raw, semaphore, value, shutdown, &mut shutdown_since) {
+            Ok(()) => FrameOutcome::Presented,
+            Err(error) => FrameOutcome::Lost(format!("{error:#}")),
+        };
+        for callback in callbacks {
+            callback(outcome.clone());
+        }
+    }
+}
+
+/// Waits until the GPU reached `value`. A slow GPU is waited for (logged once after [`PATIENCE`]); only a lost
+/// device, or a shutdown that has waited [`PATIENCE`] since it began (`shutdown_since`, shared by every wait of the
+/// thread), ends the wait without it — and once that deadline passed, every later wait only checks, without waiting.
+fn wait_value(
+    raw: &ash::Device,
+    semaphore: vk::Semaphore,
+    value: u64,
+    shutdown: &AtomicBool,
+    shutdown_since: &mut Option<Instant>,
+) -> Result<()> {
+    let semaphores = [semaphore];
+    let values = [value];
+    let info = vk::SemaphoreWaitInfo::default().semaphores(&semaphores).values(&values);
+    let started = Instant::now();
+    let mut logged = false;
+    loop {
+        let expired = shutdown_since.is_some_and(|since| since.elapsed() >= PATIENCE);
+        let timeout = if expired { 0 } else { Duration::from_millis(100).as_nanos() as u64 };
+        // SAFETY: the semaphore and device stay alive while this thread runs (`Timeline` joins it before destroying
+        // the semaphore and keeps the device); waiting needs no external synchronization.
+        match unsafe { raw.wait_semaphores(&info, timeout) } {
+            Ok(()) => return Ok(()),
+            Err(vk::Result::TIMEOUT) => {}
+            Err(error) => bail!("waiting for the frame's submission: {error}"),
+        }
+        if expired {
+            bail!("the renderer shut down before the GPU finished the frame");
+        }
+        if !logged && started.elapsed() >= PATIENCE {
+            log::warn!("external surfaces: the GPU has not finished a frame for {PATIENCE:?}; still waiting");
+            logged = true;
+        }
+        if shutdown.load(Ordering::Relaxed) {
+            shutdown_since.get_or_insert_with(Instant::now);
+        }
+    }
+}
diff -ruN a/src/external_surface/device.rs b/src/external_surface/device.rs
--- a/src/external_surface/device.rs
+++ b/src/external_surface/device.rs
@@ -0,0 +1,294 @@
+//! The Vulkan device that imports dmabufs, and what it imports (`gpui::dmabuf_import_caps`).
+
+use super::{FORMATS, fourcc_name};
+use anyhow::{Context as _, Result, ensure};
+use ash::vk;
+use gpui::{DmaBufFormat, DmaBufImportCaps, DmaBufModifier};
+use std::ffi::CStr;
+use std::os::unix::fs::MetadataExt as _;
+use std::path::PathBuf;
+use wgpu::hal::vulkan;
+
+/// The device extensions dmabuf import needs beyond what wgpu enables by itself: the external memory pair (wgpu adds
+/// them where supported), DRM format modifiers (wgpu never does) and the foreign queue family a dmabuf is acquired
+/// from and released to.
+pub(super) const EXTENSIONS: [&CStr; 4] = [
+    ash::khr::external_memory_fd::NAME,
+    ash::ext::external_memory_dma_buf::NAME,
+    ash::ext::image_drm_format_modifier::NAME,
+    ash::ext::queue_family_foreign::NAME,
+];
+
+/// Opens `adapter` as a Vulkan device that imports dmabufs; `None` when it is not a Vulkan adapter or cannot import
+/// them (the caller then opens it as wgpu would, and [`record_caps`] says why).
+pub(crate) fn open_device(
+    adapter: &wgpu::Adapter,
+    desc: &wgpu::DeviceDescriptor<'_>,
+) -> Option<(wgpu::Device, wgpu::Queue)> {
+    let open = {
+        // SAFETY: the guard is only read here and dropped before the adapter is used again.
+        let hal_adapter = unsafe { adapter.as_hal::<vulkan::Api>() }?;
+        if let Err(reason) = missing_requirements(&hal_adapter) {
+            log::info!("dmabuf import unavailable on {}: {reason}", adapter.get_info().name);
+            return None;
+        }
+        let callback: Box<vulkan::CreateDeviceCallback<'_>> = Box::new(|args| {
+            for extension in EXTENSIONS {
+                if !args.extensions.contains(&extension) {
+                    args.extensions.push(extension);
+                }
+            }
+        });
+        // SAFETY: the callback only adds extensions the physical device supports (`missing_requirements` checked
+        // each), which wgpu-hal allows; features, limits and hints are the descriptor's, as `request_device` passes.
+        let opened = unsafe {
+            hal_adapter.open_with_callback(
+                desc.required_features,
+                &desc.required_limits,
+                &desc.memory_hints,
+                Some(callback),
+            )
+        };
+        match opened {
+            Ok(open) => open,
+            Err(error) => {
+                log::warn!("opening the Vulkan device with dmabuf import failed: {error}");
+                return None;
+            }
+        }
+    };
+    // SAFETY: `open` was opened from this adapter's own physical device with the descriptor's features and limits.
+    match unsafe { adapter.create_device_from_hal::<vulkan::Api>(open, desc) } {
+        Ok(pair) => Some(pair),
+        Err(error) => {
+            log::warn!("wrapping the Vulkan device with dmabuf import failed: {error}");
+            None
+        }
+    }
+}
+
+/// Why `adapter` cannot import dmabufs, if it cannot.
+fn missing_requirements(adapter: &vulkan::Adapter) -> Result<(), String> {
+    let capabilities = adapter.physical_device_capabilities();
+    let missing: Vec<String> = EXTENSIONS
+        .iter()
+        .filter(|extension| !capabilities.supports_extension(extension))
+        .map(|extension| extension.to_string_lossy().into_owned())
+        .collect();
+    if !missing.is_empty() {
+        return Err(format!("missing {}", missing.join(", ")));
+    }
+    // The completion thread waits with core 1.2's vkWaitSemaphores on a timeline semaphore; wgpu enables the
+    // timeline feature whenever the physical device has it.
+    let api = capabilities
+        .properties()
+        .api_version
+        .min(adapter.shared_instance().instance_api_version());
+    if api < vk::API_VERSION_1_2 {
+        return Err(format!(
+            "Vulkan {}.{} (timeline semaphores need 1.2)",
+            vk::api_version_major(api),
+            vk::api_version_minor(api)
+        ));
+    }
+    let mut features12 = vk::PhysicalDeviceVulkan12Features::default();
+    let mut features = vk::PhysicalDeviceFeatures2::default().push_next(&mut features12);
+    // SAFETY: the physical device is the adapter's and the instance supports Vulkan 1.2 (checked above), so
+    // vkGetPhysicalDeviceFeatures2 exists and accepts the 1.2 feature struct.
+    unsafe {
+        adapter
+            .shared_instance()
+            .raw_instance()
+            .get_physical_device_features2(adapter.raw_physical_device(), &mut features);
+    }
+    if features12.timeline_semaphore != vk::TRUE {
+        return Err("no timeline semaphores".to_owned());
+    }
+    Ok(())
+}
+
+/// Publishes what `device` (opened from `adapter`) imports, as `gpui::dmabuf_import_caps`.
+pub(crate) fn record_caps(adapter: &wgpu::Adapter, device: &wgpu::Device) {
+    let name = adapter.get_info().name;
+    let caps = match import_caps(adapter, device) {
+        Ok(caps) => caps,
+        Err(reason) => DmaBufImportCaps {
+            adapter: name,
+            render_node: None,
+            formats: Vec::new(),
+            unsupported: Some(format!("{reason:#}")),
+        },
+    };
+    match &caps.unsupported {
+        None => log::info!(
+            "dmabuf import on {} ({}): {}",
+            caps.adapter,
+            caps.render_node
+                .as_ref()
+                .map_or_else(|| "no render node".to_owned(), |node| node.display().to_string()),
+            caps.formats
+                .iter()
+                .map(|format| format!("{} x{}", fourcc_name(format.fourcc), format.modifiers.len()))
+                .collect::<Vec<_>>()
+                .join(", ")
+        ),
+        Some(reason) => log::info!("no dmabuf import on {}: {reason}", caps.adapter),
+    }
+    gpui::set_dmabuf_import_caps(caps);
+}
+
+fn import_caps(adapter: &wgpu::Adapter, device: &wgpu::Device) -> Result<DmaBufImportCaps> {
+    let info = adapter.get_info();
+    ensure!(
+        info.backend == wgpu::Backend::Vulkan,
+        "the GPU renders through {:?}, not Vulkan",
+        info.backend
+    );
+    {
+        // SAFETY: the guard is only read and dropped at the end of this block.
+        let hal_device = unsafe { device.as_hal::<vulkan::Api>() }.context("not a Vulkan device")?;
+        let enabled = hal_device.enabled_device_extensions();
+        let missing: Vec<_> = EXTENSIONS.iter().filter(|extension| !enabled.contains(extension)).collect();
+        ensure!(
+            missing.is_empty(),
+            "the device was opened without {}",
+            missing
+                .iter()
+                .map(|extension| extension.to_string_lossy())
+                .collect::<Vec<_>>()
+                .join(", ")
+        );
+    }
+    // SAFETY: the guard is only read and dropped at the end of this function.
+    let hal_adapter = unsafe { adapter.as_hal::<vulkan::Api>() }.context("not a Vulkan adapter")?;
+    let formats: Vec<DmaBufFormat> = FORMATS
+        .iter()
+        .filter_map(|format| {
+            let modifiers = importable_modifiers(&hal_adapter, format.vk);
+            (!modifiers.is_empty()).then(|| DmaBufFormat {
+                fourcc: format.fourcc,
+                modifiers,
+            })
+        })
+        .collect();
+    let unsupported = formats
+        .is_empty()
+        .then(|| "the device imports none of AR24, XR24, AB24, XB24 as a copy source".to_owned());
+    Ok(DmaBufImportCaps {
+        adapter: info.name,
+        render_node: render_node(&hal_adapter),
+        formats,
+        unsupported,
+    })
+}
+
+/// The modifiers of `format` the adapter copies from an imported dmabuf, in the driver's order.
+fn importable_modifiers(adapter: &vulkan::Adapter, format: vk::Format) -> Vec<DmaBufModifier> {
+    let instance = adapter.shared_instance().raw_instance();
+    let physical = adapter.raw_physical_device();
+    let mut list = vk::DrmFormatModifierPropertiesListEXT::default();
+    // SAFETY: Vulkan 1.2 and VK_EXT_image_drm_format_modifier are present (`missing_requirements`); the first call
+    // only fills the count, the list pointing nowhere.
+    unsafe {
+        instance.get_physical_device_format_properties2(
+            physical,
+            format,
+            &mut vk::FormatProperties2::default().push_next(&mut list),
+        );
+    }
+    let mut properties = vec![vk::DrmFormatModifierPropertiesEXT::default(); list.drm_format_modifier_count as usize];
+    let mut list = vk::DrmFormatModifierPropertiesListEXT::default().drm_format_modifier_properties(&mut properties);
+    // SAFETY: as above; the list now points at `properties`, which holds the count the first call returned.
+    unsafe {
+        instance.get_physical_device_format_properties2(
+            physical,
+            format,
+            &mut vk::FormatProperties2::default().push_next(&mut list),
+        );
+    }
+    let count = list.drm_format_modifier_count as usize;
+    properties.truncate(count);
+    properties
+        .iter()
+        .filter(|properties| {
+            properties
+                .drm_format_modifier_tiling_features
+                .contains(vk::FormatFeatureFlags::TRANSFER_SRC)
+                && imports(adapter, format, properties.drm_format_modifier)
+        })
+        .map(|properties| DmaBufModifier {
+            modifier: properties.drm_format_modifier,
+            plane_count: properties.drm_format_modifier_plane_count,
+        })
+        .collect()
+}
+
+/// Whether a dmabuf of `format` with `modifier` imports as a 2D image to copy from.
+fn imports(adapter: &vulkan::Adapter, format: vk::Format, modifier: u64) -> bool {
+    let mut external_info =
+        vk::PhysicalDeviceExternalImageFormatInfo::default().handle_type(vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT);
+    let mut modifier_info = vk::PhysicalDeviceImageDrmFormatModifierInfoEXT::default()
+        .drm_format_modifier(modifier)
+        .sharing_mode(vk::SharingMode::EXCLUSIVE);
+    let info = vk::PhysicalDeviceImageFormatInfo2::default()
+        .format(format)
+        .ty(vk::ImageType::TYPE_2D)
+        .tiling(vk::ImageTiling::DRM_FORMAT_MODIFIER_EXT)
+        .usage(vk::ImageUsageFlags::TRANSFER_SRC)
+        .push_next(&mut external_info)
+        .push_next(&mut modifier_info);
+    let mut external = vk::ExternalImageFormatProperties::default();
+    let mut properties = vk::ImageFormatProperties2::default().push_next(&mut external);
+    // SAFETY: Vulkan 1.2 and the external memory and modifier extensions are present (`missing_requirements`); every
+    // struct of both chains lives until the call returns.
+    let result = unsafe {
+        adapter
+            .shared_instance()
+            .raw_instance()
+            .get_physical_device_image_format_properties2(adapter.raw_physical_device(), &info, &mut properties)
+    };
+    result.is_ok()
+        && external
+            .external_memory_properties
+            .external_memory_features
+            .contains(vk::ExternalMemoryFeatureFlags::IMPORTABLE)
+}
+
+/// The adapter's DRM render node, from `VK_EXT_physical_device_drm`.
+fn render_node(adapter: &vulkan::Adapter) -> Option<PathBuf> {
+    if !adapter
+        .physical_device_capabilities()
+        .supports_extension(ash::ext::physical_device_drm::NAME)
+    {
+        return None;
+    }
+    let mut drm = vk::PhysicalDeviceDrmPropertiesEXT::default();
+    let mut properties = vk::PhysicalDeviceProperties2::default().push_next(&mut drm);
+    // SAFETY: the physical device supports VK_EXT_physical_device_drm (checked above), so the instance (Vulkan 1.2)
+    // fills its properties struct.
+    unsafe {
+        adapter
+            .shared_instance()
+            .raw_instance()
+            .get_physical_device_properties2(adapter.raw_physical_device(), &mut properties);
+    }
+    if drm.has_render != vk::TRUE {
+        return None;
+    }
+    find_render_node(drm.render_major, drm.render_minor)
+}
+
+/// The `/dev/dri` node with device number `major:minor`.
+fn find_render_node(major: i64, minor: i64) -> Option<PathBuf> {
+    let wanted = makedev(u64::try_from(major).ok()?, u64::try_from(minor).ok()?);
+    std::fs::read_dir("/dev/dri")
+        .ok()?
+        .flatten()
+        .map(|entry| entry.path())
+        .find(|path| std::fs::metadata(path).is_ok_and(|metadata| metadata.rdev() == wanted))
+}
+
+/// glibc's `makedev`.
+fn makedev(major: u64, minor: u64) -> u64 {
+    ((major & 0xffff_f000) << 32) | ((major & 0x0000_0fff) << 8) | ((minor & 0xffff_ff00) << 12) | (minor & 0x0000_00ff)
+}
diff -ruN a/src/external_surface/import.rs b/src/external_surface/import.rs
--- a/src/external_surface/import.rs
+++ b/src/external_surface/import.rs
@@ -0,0 +1,393 @@
+//! A producer's dmabuf as a raw `VkImage` wgpu never tracks, and the GPU copy that acquires it from the foreign queue
+//! family, copies it into a wgpu texture (the snapshot the renderer samples) and releases it back.
+//!
+//! wgpu cannot hold the imported image itself: every texture from hal enters wgpu-core's tracker uninitialized, so its
+//! first use is an `UNDEFINED` layout transition, which lets the driver discard the producer's pixels (Mesa ANV
+//! re-initialises fast-clear state on it, and CC modifiers keep the clear colour in the dmabuf itself), and wgpu
+//! never acquires an image from `VK_QUEUE_FAMILY_FOREIGN_EXT`. So the image stays raw: each new frame is acquired
+//! (`GENERAL`, foreign → this queue family), copied, and released (this queue family → foreign, back to `GENERAL`) in a
+//! raw-only command buffer, the snapshot handed to and from wgpu's tracker as `COPY_DST` through
+//! `CommandEncoder::transition_resources`, wgpu's documented native-interop path.
+
+use super::{Format, fourcc_name, format_of};
+use anyhow::{Context as _, Result, anyhow, bail, ensure};
+use ash::vk;
+use gpui::{DmaBufFrame, DmaBufImportCaps, DmaBuffer};
+use std::os::fd::{AsRawFd as _, IntoRawFd as _, OwnedFd};
+use std::os::unix::fs::MetadataExt as _;
+use std::sync::Weak;
+use wgpu::hal::vulkan;
+
+/// The format `buffer` is copied as, if the device imports it as it is: its format and modifier among the device's,
+/// with the modifier's plane count, every plane in one buffer object, a size the device takes.
+pub(super) fn check_buffer(caps: &DmaBufImportCaps, buffer: &DmaBuffer) -> Result<&'static Format> {
+    if let Some(reason) = &caps.unsupported {
+        bail!("the renderer's device imports no dmabufs: {reason}");
+    }
+    let format = format_of(buffer.fourcc).ok_or_else(|| anyhow!("unsupported format {}", fourcc_name(buffer.fourcc)))?;
+    let modifiers = caps
+        .formats
+        .iter()
+        .find(|candidate| candidate.fourcc == buffer.fourcc)
+        .map(|candidate| candidate.modifiers.as_slice())
+        .unwrap_or_default();
+    let modifier = modifiers
+        .iter()
+        .find(|candidate| candidate.modifier == buffer.modifier)
+        .ok_or_else(|| anyhow!("the device does not import {} with this modifier", fourcc_name(buffer.fourcc)))?;
+    ensure!(
+        buffer.planes.len() == modifier.plane_count as usize,
+        "{} planes, the modifier has {}",
+        buffer.planes.len(),
+        modifier.plane_count
+    );
+    ensure!(buffer.width > 0 && buffer.height > 0, "empty buffer");
+    ensure!(
+        planes_share_one_object(buffer)?,
+        "planes in separate buffer objects (a disjoint image is not supported)"
+    );
+    Ok(format)
+}
+
+/// Whether every plane's fd is the same dmabuf (one inode per exported buffer object).
+fn planes_share_one_object(buffer: &DmaBuffer) -> Result<bool> {
+    let identity = |fd: &OwnedFd| -> Result<(u64, u64)> {
+        let file = std::fs::File::from(fd.try_clone().context("dup a plane fd")?);
+        let metadata = file.metadata().context("fstat a plane fd")?;
+        Ok((metadata.dev(), metadata.ino()))
+    };
+    let mut planes = buffer.planes.iter();
+    let Some(first) = planes.next() else {
+        return Ok(false);
+    };
+    let first = identity(&first.fd)?;
+    for plane in planes {
+        if identity(&plane.fd)? != first {
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
+
+/// An imported dmabuf: a `VkImage` with the buffer's modifier and plane layouts, bound to a dedicated allocation
+/// importing its fd. wgpu never sees it; [`RawImage::destroy`] frees it once no submission uses it any more.
+pub(super) struct RawImage {
+    pub(super) image: vk::Image,
+    memory: vk::DeviceMemory,
+}
+
+impl RawImage {
+    /// Imports `buffer` (checked by [`check_buffer`]) on `device` as a copy source.
+    pub(super) fn import(device: &wgpu::Device, buffer: &DmaBuffer, format: &Format) -> Result<Self> {
+        // SAFETY: the guard is dropped at the end of this function, before the device is used through wgpu again.
+        let hal_device = unsafe { device.as_hal::<vulkan::Api>() }.context("the device is not Vulkan")?;
+        let (image, memory) = create_image(&hal_device, buffer, format)?;
+        Ok(Self { image, memory })
+    }
+
+    /// Destroys the image and frees its memory.
+    ///
+    /// # Safety
+    ///
+    /// `raw` is the device the image was created on, and no submitted or recorded command uses the image any more.
+    pub(super) unsafe fn destroy(self, raw: &ash::Device) {
+        // SAFETY: the caller guarantees nothing uses the image; it and its memory were created on `raw`.
+        unsafe { raw.destroy_image(self.image, None) };
+        // SAFETY: as above; the image bound to the memory is gone.
+        unsafe { raw.free_memory(self.memory, None) };
+    }
+}
+
+/// The wgpu texture a buffer's frames are copied into and sampled from.
+pub(super) fn create_snapshot(device: &wgpu::Device, buffer: &DmaBuffer, format: &Format) -> wgpu::Texture {
+    device.create_texture(&wgpu::TextureDescriptor {
+        label: Some("dmabuf_snapshot"),
+        size: wgpu::Extent3d {
+            width: buffer.width,
+            height: buffer.height,
+            depth_or_array_layers: 1,
+        },
+        mip_level_count: 1,
+        sample_count: 1,
+        dimension: wgpu::TextureDimension::D2,
+        format: format.wgpu,
+        // RENDER_ATTACHMENT for the one clear that makes wgpu count the snapshot initialized (it would otherwise clear
+        // it lazily at the first sampling, over the raw copy).
+        usage: wgpu::TextureUsages::TEXTURE_BINDING
+            | wgpu::TextureUsages::COPY_DST
+            | wgpu::TextureUsages::RENDER_ATTACHMENT,
+        view_formats: &[],
+    })
+}
+
+/// One frame to copy: from the buffer's imported image into its snapshot.
+pub(super) struct CopyJob {
+    /// The import's key.
+    pub(super) key: usize,
+    /// The frame copied, kept weakly so its address names it until the cache moves on.
+    pub(super) frame: Weak<DmaBufFrame>,
+    pub(super) source: vk::Image,
+    pub(super) snapshot: wgpu::Texture,
+    pub(super) width: u32,
+    pub(super) height: u32,
+    /// The snapshot needs its initializing clear first.
+    pub(super) clear: bool,
+}
+
+/// The two command buffers of a batch of copies, to submit in this order before the frame's own: wgpu's (the
+/// snapshots' first clear and their transition to `COPY_DST`) and the raw one (acquire, copy, release).
+pub(super) fn record(device: &wgpu::Device, jobs: &[CopyJob]) -> Result<[wgpu::CommandBuffer; 2]> {
+    let mut prepare = device.create_command_encoder(&wgpu::CommandEncoderDescriptor {
+        label: Some("external_surfaces_prepare"),
+    });
+    for job in jobs.iter().filter(|job| job.clear) {
+        let view = job.snapshot.create_view(&wgpu::TextureViewDescriptor::default());
+        drop(prepare.begin_render_pass(&wgpu::RenderPassDescriptor {
+            label: Some("dmabuf_snapshot_clear"),
+            color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                view: &view,
+                resolve_target: None,
+                ops: wgpu::Operations {
+                    load: wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT),
+                    store: wgpu::StoreOp::Store,
+                },
+                depth_slice: None,
+            })],
+            ..Default::default()
+        }));
+    }
+    prepare.transition_resources(
+        std::iter::empty(),
+        jobs.iter().map(|job| wgpu::TextureTransition {
+            texture: &job.snapshot,
+            selector: None,
+            state: wgpu::TextureUses::COPY_DST,
+        }),
+    );
+    let mut copy = device.create_command_encoder(&wgpu::CommandEncoderDescriptor {
+        label: Some("external_surfaces_copy"),
+    });
+    record_raw(device, &mut copy, jobs)?;
+    Ok([prepare.finish(), copy.finish()])
+}
+
+/// Records, raw, each job's acquire from the foreign queue family, copy into its snapshot (which wgpu left in
+/// `TRANSFER_DST_OPTIMAL` and finds there again) and release to the foreign queue family.
+fn record_raw(device: &wgpu::Device, encoder: &mut wgpu::CommandEncoder, jobs: &[CopyJob]) -> Result<()> {
+    let (raw, family) = {
+        // SAFETY: the guard is only read and dropped at the end of this block.
+        let hal_device = unsafe { device.as_hal::<vulkan::Api>() }.context("the device is not Vulkan")?;
+        (hal_device.raw_device().clone(), hal_device.queue_family_index())
+    };
+    let snapshots = jobs
+        .iter()
+        .map(|job| {
+            // SAFETY: the guard is only read and dropped at once; the handle stays valid while `job.snapshot` (held
+            // by the caller until the submission is recorded and by the cache after) lives.
+            let texture = unsafe { job.snapshot.as_hal::<vulkan::Api>() }?;
+            // SAFETY: the handle is only recorded into commands, never destroyed here.
+            Some(unsafe { texture.raw_handle() })
+        })
+        .collect::<Option<Vec<vk::Image>>>()
+        .context("a snapshot is not a Vulkan texture")?;
+    let color = vk::ImageSubresourceRange::default()
+        .aspect_mask(vk::ImageAspectFlags::COLOR)
+        .level_count(1)
+        .layer_count(1);
+    let acquire: Vec<vk::ImageMemoryBarrier<'_>> = jobs
+        .iter()
+        .map(|job| {
+            vk::ImageMemoryBarrier::default()
+                .image(job.source)
+                .subresource_range(color)
+                .src_queue_family_index(vk::QUEUE_FAMILY_FOREIGN_EXT)
+                .dst_queue_family_index(family)
+                .old_layout(vk::ImageLayout::GENERAL)
+                .new_layout(vk::ImageLayout::TRANSFER_SRC_OPTIMAL)
+                .src_access_mask(vk::AccessFlags::empty())
+                .dst_access_mask(vk::AccessFlags::TRANSFER_READ)
+        })
+        .collect();
+    let release: Vec<vk::ImageMemoryBarrier<'_>> = jobs
+        .iter()
+        .map(|job| {
+            vk::ImageMemoryBarrier::default()
+                .image(job.source)
+                .subresource_range(color)
+                .src_queue_family_index(family)
+                .dst_queue_family_index(vk::QUEUE_FAMILY_FOREIGN_EXT)
+                .old_layout(vk::ImageLayout::TRANSFER_SRC_OPTIMAL)
+                .new_layout(vk::ImageLayout::GENERAL)
+                .src_access_mask(vk::AccessFlags::TRANSFER_READ)
+                .dst_access_mask(vk::AccessFlags::empty())
+        })
+        .collect();
+    let record = |encoder: Option<&mut vulkan::CommandEncoder>| {
+        let encoder = encoder?;
+        // SAFETY: the command buffer is open (wgpu-core opened it for this call) and is only recorded into.
+        let commands = unsafe { encoder.raw_handle() };
+        // SAFETY: every image is alive (the sources are the cache's, the snapshots the jobs'); each source is
+        // released by the producer in GENERAL and owned by the foreign queue family between frames
+        // (VK_EXT_queue_family_foreign is enabled), each snapshot is in TRANSFER_DST_OPTIMAL (the prepare buffer put
+        // it there through wgpu's tracker); the copies are whole 2D images of one format and size.
+        unsafe { record_commands(&raw, commands, jobs, &snapshots, &acquire, &release) };
+        Some(())
+    };
+    // SAFETY: a raw-only encoder (wgpu forbids mixing it with wgpu commands), so wgpu records nothing into it.
+    let recorded = unsafe { encoder.as_hal_mut::<vulkan::Api, _, _>(record) };
+    recorded.context("the copy encoder is not a Vulkan encoder")
+}
+
+/// # Safety
+///
+/// As at the call in [`record_raw`].
+unsafe fn record_commands(
+    raw: &ash::Device,
+    commands: vk::CommandBuffer,
+    jobs: &[CopyJob],
+    snapshots: &[vk::Image],
+    acquire: &[vk::ImageMemoryBarrier<'_>],
+    release: &[vk::ImageMemoryBarrier<'_>],
+) {
+    // SAFETY: see the caller.
+    unsafe {
+        raw.cmd_pipeline_barrier(
+            commands,
+            vk::PipelineStageFlags::TOP_OF_PIPE,
+            vk::PipelineStageFlags::TRANSFER,
+            vk::DependencyFlags::empty(),
+            &[],
+            &[],
+            acquire,
+        );
+    }
+    let layers = vk::ImageSubresourceLayers::default()
+        .aspect_mask(vk::ImageAspectFlags::COLOR)
+        .layer_count(1);
+    for (job, &snapshot) in jobs.iter().zip(snapshots) {
+        let region = vk::ImageCopy::default()
+            .src_subresource(layers)
+            .dst_subresource(layers)
+            .extent(vk::Extent3D {
+                width: job.width,
+                height: job.height,
+                depth: 1,
+            });
+        // SAFETY: see the caller.
+        unsafe {
+            raw.cmd_copy_image(
+                commands,
+                job.source,
+                vk::ImageLayout::TRANSFER_SRC_OPTIMAL,
+                snapshot,
+                vk::ImageLayout::TRANSFER_DST_OPTIMAL,
+                &[region],
+            );
+        }
+    }
+    // SAFETY: see the caller.
+    unsafe {
+        raw.cmd_pipeline_barrier(
+            commands,
+            vk::PipelineStageFlags::TRANSFER,
+            vk::PipelineStageFlags::BOTTOM_OF_PIPE,
+            vk::DependencyFlags::empty(),
+            &[],
+            &[],
+            release,
+        );
+    }
+}
+
+/// A `VkImage` over `buffer`'s memory: the modifier's tiling with every plane's layout, bound to a dedicated
+/// allocation importing the buffer's dmabuf.
+fn create_image(device: &vulkan::Device, buffer: &DmaBuffer, format: &Format) -> Result<(vk::Image, vk::DeviceMemory)> {
+    let raw = device.raw_device();
+    let plane_layouts: Vec<vk::SubresourceLayout> = buffer
+        .planes
+        .iter()
+        .map(|plane| vk::SubresourceLayout {
+            offset: u64::from(plane.offset),
+            size: 0,
+            row_pitch: u64::from(plane.stride),
+            array_pitch: 0,
+            depth_pitch: 0,
+        })
+        .collect();
+    let mut modifier_info = vk::ImageDrmFormatModifierExplicitCreateInfoEXT::default()
+        .drm_format_modifier(buffer.modifier)
+        .plane_layouts(&plane_layouts);
+    let mut external_info =
+        vk::ExternalMemoryImageCreateInfo::default().handle_types(vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT);
+    // `initial_layout` UNDEFINED is what an external-memory image must be created with; no barrier ever transitions
+    // from it (every acquire names GENERAL, the layout the producer hands buffers over in).
+    let image_info = vk::ImageCreateInfo::default()
+        .image_type(vk::ImageType::TYPE_2D)
+        .format(format.vk)
+        .extent(vk::Extent3D {
+            width: buffer.width,
+            height: buffer.height,
+            depth: 1,
+        })
+        .mip_levels(1)
+        .array_layers(1)
+        .samples(vk::SampleCountFlags::TYPE_1)
+        .tiling(vk::ImageTiling::DRM_FORMAT_MODIFIER_EXT)
+        .usage(vk::ImageUsageFlags::TRANSFER_SRC)
+        .sharing_mode(vk::SharingMode::EXCLUSIVE)
+        .initial_layout(vk::ImageLayout::UNDEFINED)
+        .push_next(&mut external_info)
+        .push_next(&mut modifier_info);
+    // SAFETY: the device has VK_EXT_image_drm_format_modifier and the external memory extensions (`open_device`), and
+    // `check_buffer` matched the format, the modifier and its plane count against what the device reports it imports
+    // as a copy source; every chained struct lives until the call returns.
+    let image = unsafe { raw.create_image(&image_info, None) }.context("vkCreateImage")?;
+    match bind_imported_memory(device, image, buffer) {
+        Ok(memory) => Ok((image, memory)),
+        Err(error) => {
+            // SAFETY: the image was created above, bound to nothing and used by nothing.
+            unsafe { raw.destroy_image(image, None) };
+            Err(error)
+        }
+    }
+}
+
+/// Allocates memory importing `buffer`'s dmabuf for `image` and binds it.
+fn bind_imported_memory(device: &vulkan::Device, image: vk::Image, buffer: &DmaBuffer) -> Result<vk::DeviceMemory> {
+    let raw = device.raw_device();
+    let instance = device.shared_instance().raw_instance();
+    let first = buffer.planes.first().ok_or_else(|| anyhow!("no planes"))?;
+    let fd = first.fd.try_clone().context("dup the dmabuf fd")?;
+    let fd_device = ash::khr::external_memory_fd::Device::new(instance, raw);
+    let mut fd_properties = vk::MemoryFdPropertiesKHR::default();
+    // SAFETY: VK_KHR_external_memory_fd is enabled on this device; `fd` is an open dmabuf this function owns.
+    unsafe {
+        fd_device.get_memory_fd_properties(vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT, fd.as_raw_fd(), &mut fd_properties)
+    }
+    .context("vkGetMemoryFdPropertiesKHR")?;
+    // SAFETY: `image` was created on this device and is not bound yet.
+    let requirements = unsafe { raw.get_image_memory_requirements(image) };
+    let type_bits = requirements.memory_type_bits & fd_properties.memory_type_bits;
+    ensure!(type_bits != 0, "no memory type fits both the image and the dmabuf");
+    let mut import = vk::ImportMemoryFdInfoKHR::default()
+        .handle_type(vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT)
+        .fd(fd.as_raw_fd());
+    let mut dedicated = vk::MemoryDedicatedAllocateInfo::default().image(image);
+    let allocate = vk::MemoryAllocateInfo::default()
+        .allocation_size(requirements.size)
+        .memory_type_index(type_bits.trailing_zeros())
+        .push_next(&mut import)
+        .push_next(&mut dedicated);
+    // SAFETY: the memory type is one both the image and the dmabuf accept, the allocation is dedicated to `image`,
+    // and `fd` is open. On success Vulkan owns the fd (released from `OwnedFd` below without closing it); on failure
+    // it stays ours and `fd` closes it as it drops.
+    let memory = unsafe { raw.allocate_memory(&allocate, None) }.context("vkAllocateMemory (dmabuf import)")?;
+    let _owned_by_vulkan = fd.into_raw_fd();
+    // SAFETY: `memory` was allocated for `image` (dedicated, of its size) and neither is bound or in use.
+    if let Err(error) = unsafe { raw.bind_image_memory(image, memory, 0) } {
+        // SAFETY: `memory` was allocated above and is bound to nothing.
+        unsafe { raw.free_memory(memory, None) };
+        bail!("vkBindImageMemory: {error}");
+    }
+    Ok(memory)
+}
diff -ruN a/src/external_surface.rs b/src/external_surface.rs
--- a/src/external_surface.rs
+++ b/src/external_surface.rs
@@ -0,0 +1,616 @@
+//! External surfaces on Linux (an agterm-rs patch): draws `gpui::ExternalSurface` frames — dmabufs a producer
+//! rendered on this GPU, and CPU pixels uploaded by damaged rectangle into a texture kept per surface — and opens the
+//! Vulkan device so that it can import dmabufs.
+//!
+//! - Device ([`device`]): wgpu enables `VK_KHR_external_memory_fd` and `VK_EXT_external_memory_dma_buf` where
+//!   supported but never `VK_EXT_image_drm_format_modifier` (needed to describe any GPU-rendered buffer) nor
+//!   `VK_EXT_queue_family_foreign` (needed to take a buffer over from its producer), so [`open_device`] opens the
+//!   adapter through wgpu-hal's `open_with_callback` adding them. [`record_caps`] publishes what the device imports
+//!   (`gpui::dmabuf_import_caps`): its DRM render node (`VK_EXT_physical_device_drm`) and the formats and modifiers it
+//!   copies from an imported dmabuf.
+//! - Import ([`import`]): one raw `VkImage` per producer buffer with its modifier and every memory plane's layout (a
+//!   non-disjoint image: Intel's CCS modifiers keep three planes in one object), checked against the capabilities
+//!   first, bound to a dedicated allocation importing the dmabuf, never handed to wgpu. Each new frame is acquired from
+//!   the foreign queue family in `GENERAL`, copied on the GPU into a wgpu texture (the buffer's snapshot, which the
+//!   renderer samples) and released back; redraws of the same frame sample the snapshot alone. wgpu cannot hold the
+//!   imported image itself: its first use would be an `UNDEFINED` layout transition, which lets the driver discard
+//!   the producer's pixels, and it never transfers queue-family ownership. Imports are cached per `gpui::DmaBuffer`
+//!   and destroyed once the producer dropped the buffer and the GPU finished the last copy from it.
+//! - Completion ([`completion`]): a frame reports `Presented` once the GPU finished the submission that copied or
+//!   first drew it — from then on the renderer never reads the producer's buffer for it — `Lost` when that cannot be
+//!   known (device lost), `Discarded` when it was never submitted, `Failed` when it does not import.
+//! - Acquire: the producer's rendering must be finished before a frame is handed over (the caller waits on the
+//!   producer's fence); the renderer adds no wait of its own.
+
+mod completion;
+mod device;
+mod import;
+
+pub(crate) use device::{open_device, record_caps};
+
+use anyhow::{Result, anyhow, bail, ensure};
+use ash::vk;
+use collections::FxHashMap;
+use completion::Timeline;
+use gpui::external_surface_counters as counters;
+use gpui::{DmaBufFrame, DmaBuffer, ExternalSurface, FrameOutcome, PaintSurface, PixelFrame, PixelSurface};
+use import::{CopyJob, RawImage};
+use std::sync::{Arc, Weak};
+use std::time::Duration;
+use wgpu::hal::vulkan;
+
+/// `fourcc_code` of `drm_fourcc.h`.
+const fn fourcc(code: &[u8; 4]) -> u32 {
+    u32::from_le_bytes(*code)
+}
+
+/// A DRM format the renderer draws: its Vulkan and wgpu formats, and whether its fourth channel is padding.
+struct Format {
+    fourcc: u32,
+    vk: vk::Format,
+    wgpu: wgpu::TextureFormat,
+    opaque: bool,
+}
+
+/// The formats an external surface may have: 8-bit RGB with alpha or padding, in either byte order. DRM names
+/// channels from the most significant bit of a little-endian word, so `AR24` (ARGB8888) is B, G, R, A in memory.
+const FORMATS: [Format; 4] = [
+    Format {
+        fourcc: fourcc(b"AR24"),
+        vk: vk::Format::B8G8R8A8_UNORM,
+        wgpu: wgpu::TextureFormat::Bgra8Unorm,
+        opaque: false,
+    },
+    Format {
+        fourcc: fourcc(b"XR24"),
+        vk: vk::Format::B8G8R8A8_UNORM,
+        wgpu: wgpu::TextureFormat::Bgra8Unorm,
+        opaque: true,
+    },
+    Format {
+        fourcc: fourcc(b"AB24"),
+        vk: vk::Format::R8G8B8A8_UNORM,
+        wgpu: wgpu::TextureFormat::Rgba8Unorm,
+        opaque: false,
+    },
+    Format {
+        fourcc: fourcc(b"XB24"),
+        vk: vk::Format::R8G8B8A8_UNORM,
+        wgpu: wgpu::TextureFormat::Rgba8Unorm,
+        opaque: true,
+    },
+];
+
+fn format_of(fourcc: u32) -> Option<&'static Format> {
+    FORMATS.iter().find(|format| format.fourcc == fourcc)
+}
+
+fn fourcc_name(fourcc: u32) -> String {
+    fourcc
+        .to_le_bytes()
+        .iter()
+        .map(|&byte| if byte.is_ascii_graphic() { char::from(byte) } else { '?' })
+        .collect()
+}
+
+
+// MARK: - the renderer's side
+
+/// A producer's buffer as the renderer holds it: the imported image and the snapshot the renderer samples.
+struct Import {
+    buffer: Weak<DmaBuffer>,
+    source: RawImage,
+    snapshot: wgpu::Texture,
+    view: wgpu::TextureView,
+    opaque: bool,
+    /// The frame whose pixels the snapshot holds (its copy, and before the first one the snapshot's initializing
+    /// clear, was submitted); weak, so its address stays its own.
+    copied: Option<Weak<DmaBufFrame>>,
+    /// The timeline value of the last submission that copied from `source` (0: none, or known finished).
+    last_use: u64,
+}
+
+/// The texture of a CPU-pixel surface.
+struct PixelTexture {
+    surface: Weak<PixelSurface>,
+    texture: wgpu::Texture,
+    view: wgpu::TextureView,
+    width: u32,
+    height: u32,
+    /// The serial of the frame uploaded last.
+    serial: u64,
+}
+
+type Callback = Box<dyn FnOnce(FrameOutcome) + Send>;
+
+/// What `prepare` recorded for the frame about to be submitted; the cache learns of it only once it was submitted.
+#[derive(Default)]
+struct Pending {
+    /// The copies recorded: (import key, frame).
+    copies: Vec<(usize, Weak<DmaBufFrame>)>,
+    /// Their command buffers, submitted before the frame's own.
+    command_buffers: Vec<wgpu::CommandBuffer>,
+    /// The completions of frames this frame copies or draws for the first time.
+    completing: Vec<Callback>,
+}
+
+/// The renderer's external surfaces: imports, pixel textures, this frame's draws and pending work.
+#[derive(Default)]
+pub(crate) struct ExternalSurfaces {
+    /// By `Arc::as_ptr` of the buffer: the weak reference keeps the allocation, so the address is not reused while
+    /// the entry exists.
+    imports: FxHashMap<usize, Import>,
+    /// Buffers that did not import, keyed as `imports`, with why: a frame shown again is not imported again.
+    failed: FxHashMap<usize, (Weak<DmaBuffer>, String)>,
+    pixels: FxHashMap<usize, PixelTexture>,
+    /// Imported images whose buffer is gone, with the last timeline value that used them.
+    retired: Vec<(RawImage, u64)>,
+    /// One bind group per `scene.surfaces` entry, in scene order; `None` when that frame is not drawn.
+    draws: Vec<Option<wgpu::BindGroup>>,
+    pending: Pending,
+    timeline: Option<Timeline>,
+    timeline_failed: bool,
+    /// The device the raw images belong to, kept alive while any exists.
+    device: Option<(wgpu::Device, ash::Device)>,
+}
+
+/// Uniforms of one external surface draw (`ExternalSurfaceParams` in shaders.wgsl).
+#[repr(C)]
+#[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+pub(crate) struct ExternalSurfaceParams {
+    pub(crate) bounds: [f32; 4],
+    pub(crate) content_mask: [f32; 4],
+    pub(crate) opaque: u32,
+    pub(crate) pad: [u32; 3],
+}
+
+/// What [`ExternalSurfaces::prepare`] needs from the renderer.
+pub(crate) struct Resources<'a> {
+    pub(crate) device: &'a wgpu::Device,
+    pub(crate) queue: &'a wgpu::Queue,
+    pub(crate) layout: &'a wgpu::BindGroupLayout,
+    pub(crate) sampler: &'a wgpu::Sampler,
+}
+
+impl ExternalSurfaces {
+    /// The bind group drawing `scene.surfaces[index]`, if that frame is drawn.
+    pub(crate) fn draw(&self, index: usize) -> Option<&wgpu::BindGroup> {
+        self.draws.get(index).and_then(Option::as_ref)
+    }
+
+    /// Imports, copies, uploads and binds this frame's surfaces, and forgets what their producers dropped.
+    pub(crate) fn prepare(&mut self, resources: &Resources<'_>, surfaces: &[PaintSurface]) {
+        self.retire();
+        self.draws.clear();
+        let mut jobs = Vec::new();
+        for surface in surfaces {
+            let drawn = match &surface.source {
+                ExternalSurface::DmaBuf(frame) => self.dmabuf_view(resources.device, frame, &mut jobs),
+                ExternalSurface::Pixels(frame) => self.pixel_view(resources, frame).map(|view| (view, false)),
+            };
+            match drawn {
+                Ok((view, opaque)) => {
+                    let params = ExternalSurfaceParams {
+                        bounds: bounds(surface.bounds),
+                        content_mask: bounds(surface.content_mask.bounds),
+                        opaque: u32::from(opaque),
+                        pad: [0; 3],
+                    };
+                    self.draws.push(Some(bind_group(resources, &view, &params)));
+                    if let Some(callback) = surface.source.completion().take() {
+                        self.pending.completing.push(callback);
+                    }
+                }
+                Err(error) => {
+                    self.draws.push(None);
+                    surface.source.completion().complete(FrameOutcome::Failed(format!("{error:#}")));
+                }
+            }
+        }
+        if jobs.is_empty() {
+            return;
+        }
+        match import::record(resources.device, &jobs) {
+            Ok(command_buffers) => {
+                counters::add(&counters::COPIES, jobs.len() as u64);
+                self.pending.command_buffers.extend(command_buffers);
+                self.pending
+                    .copies
+                    .extend(jobs.into_iter().map(|job| (job.key, job.frame)));
+            }
+            Err(error) => log::error!("external surfaces: recording the dmabuf copies failed: {error:#}"),
+        }
+    }
+
+    /// The command buffers to submit before the frame's own (the copies), taken.
+    pub(crate) fn command_buffers(&mut self) -> Vec<wgpu::CommandBuffer> {
+        std::mem::take(&mut self.pending.command_buffers)
+    }
+
+    /// Before the frame's submission: has it signal the timeline when it copies or first draws a frame.
+    pub(crate) fn before_submit(&mut self, device: &wgpu::Device, queue: &wgpu::Queue) -> Option<u64> {
+        if self.pending.completing.is_empty() && self.pending.copies.is_empty() {
+            return None;
+        }
+        if self.timeline.is_none() && !self.timeline_failed {
+            // SAFETY: the guard is only checked and dropped at once.
+            let vulkan = unsafe { device.as_hal::<vulkan::Api>() }.is_some();
+            if vulkan {
+                match Timeline::new(device) {
+                    Ok(timeline) => self.timeline = Some(timeline),
+                    Err(error) => {
+                        log::error!("external surfaces: no completion timeline ({error:#}); waiting for each frame");
+                        self.timeline_failed = true;
+                    }
+                }
+            } else {
+                // Not Vulkan (GL): no dmabuf imports here, and CPU pixels are copied at submission.
+                self.timeline_failed = true;
+            }
+        }
+        self.timeline.as_mut()?.signal(queue)
+    }
+
+    /// After the frame's `submission` (`signal` from [`Self::before_submit`]): the copies it recorded join the cache,
+    /// and its frames complete once the GPU finished it.
+    pub(crate) fn after_submit(
+        &mut self,
+        device: &wgpu::Device,
+        submission: wgpu::SubmissionIndex,
+        signal: Option<u64>,
+    ) {
+        let copies = std::mem::take(&mut self.pending.copies);
+        let callbacks = std::mem::take(&mut self.pending.completing);
+        let (last_use, outcome) = match (signal, &self.timeline) {
+            (Some(value), Some(_)) => (value, None),
+            _ if copies.is_empty() => (0, Some(FrameOutcome::Presented)),
+            _ => match device.poll(wgpu::PollType::Wait {
+                submission_index: Some(submission),
+                timeout: Some(Duration::from_secs(10)),
+            }) {
+                Ok(_) => (0, Some(FrameOutcome::Presented)),
+                Err(error) => (u64::MAX, Some(FrameOutcome::Lost(format!("waiting for the frame: {error}")))),
+            },
+        };
+        match (outcome, &self.timeline) {
+            (Some(outcome), _) => {
+                for callback in callbacks {
+                    callback(outcome.clone());
+                }
+            }
+            (None, Some(timeline)) => timeline.complete_at(last_use, callbacks),
+            (None, None) => {}
+        }
+        for (key, frame) in copies {
+            if let Some(import) = self.imports.get_mut(&key) {
+                import.copied = Some(frame);
+                import.last_use = last_use;
+            }
+        }
+    }
+
+    /// The frame was not submitted (recording it failed): its copies are forgotten. Its frames are still shown and the
+    /// next frame copies them again, so their completions stay pending and that frame's submission reports them: the
+    /// producer gets its buffer back only after a copy the GPU finished (or once nothing reads it at all).
+    pub(crate) fn abort_frame(&mut self) {
+        self.pending.copies.clear();
+        self.pending.command_buffers.clear();
+    }
+
+    /// Forgets what producers dropped; destroys imported images the GPU is done with.
+    fn retire(&mut self) {
+        let mut released = 0;
+        let mut kept = FxHashMap::default();
+        for (key, import) in self.imports.drain() {
+            if import.buffer.strong_count() > 0 {
+                kept.insert(key, import);
+            } else {
+                released += 1;
+                self.retired.push((import.source, import.last_use));
+            }
+        }
+        self.imports = kept;
+        counters::add(&counters::IMPORTS_RELEASED, released);
+        self.failed.retain(|_, (buffer, _)| buffer.strong_count() > 0);
+        self.pixels.retain(|_, texture| texture.surface.strong_count() > 0);
+        if self.retired.is_empty() {
+            return;
+        }
+        let reached = self.timeline.as_ref().map_or(0, Timeline::reached);
+        let Some((_, raw)) = &self.device else {
+            return;
+        };
+        let (done, waiting): (Vec<_>, Vec<_>) = std::mem::take(&mut self.retired)
+            .into_iter()
+            .partition(|(_, last_use)| *last_use <= reached);
+        self.retired = waiting;
+        for (image, _) in done {
+            // SAFETY: the producer dropped the buffer, no frame of it is pending, and the GPU reached the last
+            // submission that copied from the image; it was created on this device.
+            unsafe { image.destroy(raw) };
+        }
+    }
+
+    fn dmabuf_view(
+        &mut self,
+        device: &wgpu::Device,
+        frame: &Arc<DmaBufFrame>,
+        jobs: &mut Vec<CopyJob>,
+    ) -> Result<(wgpu::TextureView, bool)> {
+        let buffer = &frame.buffer;
+        let key = Arc::as_ptr(buffer) as usize;
+        if let Some((_, reason)) = self.failed.get(&key) {
+            bail!("{reason}");
+        }
+        if !self.imports.contains_key(&key) {
+            self.import(device, buffer, key)?;
+        }
+        let import = self.imports.get(&key).ok_or_else(|| anyhow!("import missing"))?;
+        let frame_ptr = Arc::as_ptr(frame);
+        let copied = import.copied.as_ref().is_some_and(|copied| copied.as_ptr() == frame_ptr);
+        let queued = jobs
+            .iter()
+            .any(|job| job.key == key && job.frame.as_ptr() == frame_ptr);
+        if !copied && !queued {
+            let clear = import.copied.is_none() && !jobs.iter().any(|job| job.key == key);
+            jobs.push(CopyJob {
+                key,
+                frame: Arc::downgrade(frame),
+                source: import.source.image,
+                snapshot: import.snapshot.clone(),
+                width: buffer.width,
+                height: buffer.height,
+                clear,
+            });
+        }
+        Ok((import.view.clone(), import.opaque))
+    }
+
+    fn import(&mut self, device: &wgpu::Device, buffer: &Arc<DmaBuffer>, key: usize) -> Result<()> {
+        let caps = gpui::dmabuf_import_caps().ok_or_else(|| anyhow!("the renderer has no device yet"))?;
+        let imported = import::check_buffer(&caps, buffer).and_then(|format| {
+            let source = RawImage::import(device, buffer, format)?;
+            Ok((source, format))
+        });
+        let (source, format) = match imported {
+            Ok(imported) => imported,
+            Err(error) => {
+                counters::add(&counters::IMPORT_FAILURES, 1);
+                let error = error.context(format!(
+                    "dmabuf {}x{} {} modifier {:#018x} ({} planes) does not import",
+                    buffer.width,
+                    buffer.height,
+                    fourcc_name(buffer.fourcc),
+                    buffer.modifier,
+                    buffer.planes.len()
+                ));
+                log::warn!("external surfaces: {error:#}");
+                self.failed.insert(key, (Arc::downgrade(buffer), format!("{error:#}")));
+                return Err(error);
+            }
+        };
+        if self.device.is_none() {
+            // SAFETY: the guard is only read and dropped at once; the ash device stays valid while the wgpu device
+            // kept beside it lives.
+            let raw = unsafe { device.as_hal::<vulkan::Api>() }.map(|hal| hal.raw_device().clone());
+            self.device = raw.map(|raw| (device.clone(), raw));
+        }
+        counters::add(&counters::IMPORTS, 1);
+        let snapshot = import::create_snapshot(device, buffer, format);
+        let view = snapshot.create_view(&wgpu::TextureViewDescriptor::default());
+        self.imports.insert(
+            key,
+            Import {
+                buffer: Arc::downgrade(buffer),
+                source,
+                snapshot,
+                view,
+                opaque: format.opaque,
+                copied: None,
+                last_use: 0,
+            },
+        );
+        Ok(())
+    }
+
+    fn pixel_view(&mut self, resources: &Resources<'_>, frame: &PixelFrame) -> Result<wgpu::TextureView> {
+        let expected = u64::from(frame.width) * u64::from(frame.height) * 4;
+        ensure!(
+            frame.width > 0 && frame.height > 0 && frame.pixels.len() as u64 == expected,
+            "pixel frame {}x{} with {} bytes",
+            frame.width,
+            frame.height,
+            frame.pixels.len()
+        );
+        let key = Arc::as_ptr(&frame.surface) as usize;
+        let reusable = self
+            .pixels
+            .get(&key)
+            .is_some_and(|texture| texture.width == frame.width && texture.height == frame.height);
+        if !reusable {
+            let texture = resources.device.create_texture(&wgpu::TextureDescriptor {
+                label: Some("external_pixels"),
+                size: wgpu::Extent3d {
+                    width: frame.width,
+                    height: frame.height,
+                    depth_or_array_layers: 1,
+                },
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format: wgpu::TextureFormat::Bgra8Unorm,
+                usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+                view_formats: &[],
+            });
+            let view = texture.create_view(&wgpu::TextureViewDescriptor::default());
+            self.pixels.insert(
+                key,
+                PixelTexture {
+                    surface: Arc::downgrade(&frame.surface),
+                    texture,
+                    view,
+                    width: frame.width,
+                    height: frame.height,
+                    serial: 0,
+                },
+            );
+        }
+        let texture = self
+            .pixels
+            .get_mut(&key)
+            .ok_or_else(|| anyhow!("pixel texture missing"))?;
+        if !reusable || texture.serial != frame.serial {
+            let incremental = reusable && texture.serial.checked_add(1) == Some(frame.serial);
+            upload(resources.queue, texture, frame, incremental);
+            texture.serial = frame.serial;
+        }
+        Ok(texture.view.clone())
+    }
+}
+
+impl Drop for ExternalSurfaces {
+    fn drop(&mut self) {
+        // Frames bound for a submission that will never happen: nothing reads their buffers any more.
+        self.abort_frame();
+        for callback in self.pending.completing.drain(..) {
+            callback(FrameOutcome::Discarded);
+        }
+        counters::add(&counters::IMPORTS_RELEASED, self.imports.len() as u64);
+        // Every submission that copied from an imported image must be finished before the image goes.
+        let settled = self.timeline.as_ref().is_none_or(Timeline::settle);
+        self.timeline = None;
+        let images: Vec<(RawImage, u64)> = self
+            .imports
+            .drain()
+            .map(|(_, import)| (import.source, import.last_use))
+            .chain(std::mem::take(&mut self.retired))
+            .collect();
+        let Some((_, raw)) = &self.device else {
+            return;
+        };
+        for (image, last_use) in images {
+            if settled && last_use != u64::MAX {
+                // SAFETY: the GPU finished every submission that used the image (the timeline settled, or each copy
+                // was waited for), and nothing records commands any more; it was created on this device.
+                unsafe { image.destroy(raw) };
+            } else {
+                log::warn!("external surfaces: a dmabuf copy never finished; its imported image is leaked");
+            }
+        }
+    }
+}
+
+fn bounds(bounds: gpui::Bounds<gpui::ScaledPixels>) -> [f32; 4] {
+    [
+        bounds.origin.x.0,
+        bounds.origin.y.0,
+        bounds.size.width.0,
+        bounds.size.height.0,
+    ]
+}
+
+fn bind_group(resources: &Resources<'_>, view: &wgpu::TextureView, params: &ExternalSurfaceParams) -> wgpu::BindGroup {
+    use wgpu::util::DeviceExt as _;
+    let uniform = resources.device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+        label: Some("external_surface_params"),
+        contents: bytemuck::bytes_of(params),
+        usage: wgpu::BufferUsages::UNIFORM,
+    });
+    resources.device.create_bind_group(&wgpu::BindGroupDescriptor {
+        label: Some("external_surface"),
+        layout: resources.layout,
+        entries: &[
+            wgpu::BindGroupEntry {
+                binding: 4,
+                resource: uniform.as_entire_binding(),
+            },
+            wgpu::BindGroupEntry {
+                binding: 5,
+                resource: wgpu::BindingResource::TextureView(view),
+            },
+            wgpu::BindGroupEntry {
+                binding: 6,
+                resource: wgpu::BindingResource::Sampler(resources.sampler),
+            },
+        ],
+    })
+}
+
+/// The bind group layout of external surface draws (group 1 of `vs_external_surface`/`fs_external_surface`).
+pub(crate) fn bind_group_layout(device: &wgpu::Device) -> wgpu::BindGroupLayout {
+    device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+        label: Some("external_surfaces_layout"),
+        entries: &[
+            wgpu::BindGroupLayoutEntry {
+                binding: 4,
+                visibility: wgpu::ShaderStages::VERTEX_FRAGMENT,
+                ty: wgpu::BindingType::Buffer {
+                    ty: wgpu::BufferBindingType::Uniform,
+                    has_dynamic_offset: false,
+                    min_binding_size: std::num::NonZeroU64::new(std::mem::size_of::<ExternalSurfaceParams>() as u64),
+                },
+                count: None,
+            },
+            wgpu::BindGroupLayoutEntry {
+                binding: 5,
+                visibility: wgpu::ShaderStages::FRAGMENT,
+                ty: wgpu::BindingType::Texture {
+                    sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                    view_dimension: wgpu::TextureViewDimension::D2,
+                    multisampled: false,
+                },
+                count: None,
+            },
+            wgpu::BindGroupLayoutEntry {
+                binding: 6,
+                visibility: wgpu::ShaderStages::FRAGMENT,
+                ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                count: None,
+            },
+        ],
+    })
+}
+
+/// Uploads `frame` into `texture`: its damaged rectangles when the texture holds the frame before it, else all of it.
+fn upload(queue: &wgpu::Queue, texture: &PixelTexture, frame: &PixelFrame, incremental: bool) {
+    let whole = [gpui::PixelRect {
+        x: 0,
+        y: 0,
+        width: frame.width,
+        height: frame.height,
+    }];
+    let rects: &[gpui::PixelRect] = if incremental { &frame.damage } else { &whole };
+    let stride = frame.width * 4;
+    for rect in rects {
+        let x = rect.x.min(frame.width);
+        let y = rect.y.min(frame.height);
+        let width = rect.width.min(frame.width - x);
+        let height = rect.height.min(frame.height - y);
+        if width == 0 || height == 0 {
+            continue;
+        }
+        let start = y as usize * stride as usize + x as usize * 4;
+        let end = (y + height - 1) as usize * stride as usize + (x + width) as usize * 4;
+        queue.write_texture(
+            wgpu::TexelCopyTextureInfo {
+                texture: &texture.texture,
+                mip_level: 0,
+                origin: wgpu::Origin3d { x, y, z: 0 },
+                aspect: wgpu::TextureAspect::All,
+            },
+            &frame.pixels[start..end],
+            wgpu::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(stride),
+                rows_per_image: Some(height),
+            },
+            wgpu::Extent3d {
+                width,
+                height,
+                depth_or_array_layers: 1,
+            },
+        );
+        counters::add(&counters::PIXEL_BYTES_UPLOADED, u64::from(width) * u64::from(height) * 4);
+    }
+}
