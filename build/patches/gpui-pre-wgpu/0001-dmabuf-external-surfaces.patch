+// --- external surfaces (agterm-rs patch) --- //
+// Frames produced outside GPUI on Linux: one texture of premultiplied texels (an imported dmabuf or uploaded CPU
+// pixels), whose alpha is padding when `opaque` is set. Bindings 4-6 keep clear of the surfaces' 0-3 in group 1.
+
+struct ExternalSurfaceParams {
+    bounds: Bounds,
+    content_mask: Bounds,
+    opaque: u32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+}
+
+@group(1) @binding(4) var<uniform> external_surface: ExternalSurfaceParams;
+@group(1) @binding(5) var t_external: texture_2d<f32>;
+@group(1) @binding(6) var s_external: sampler;
+
+struct ExternalSurfaceVarying {
+    @builtin(position) position: vec4<f32>,
+    @location(0) texture_position: vec2<f32>,
+    @location(3) clip_distances: vec4<f32>,
+}
+
+@vertex
+fn vs_external_surface(@builtin(vertex_index) vertex_id: u32) -> ExternalSurfaceVarying {
+    let unit_vertex = vec2<f32>(f32(vertex_id & 1u), 0.5 * f32(vertex_id & 2u));
+
+    var out = ExternalSurfaceVarying();
+    out.position = to_device_position(unit_vertex, external_surface.bounds);
+    out.texture_position = unit_vertex;
+    out.clip_distances = distance_from_clip_rect(unit_vertex, external_surface.bounds, external_surface.content_mask);
+    return out;
+}
+
+@fragment
+fn fs_external_surface(input: ExternalSurfaceVarying) -> @location(0) vec4<f32> {
+    if (any(input.clip_distances < vec4<f32>(0.0))) {
+        return vec4<f32>(0.0);
+    }
+    let texel = textureSampleLevel(t_external, s_external, input.texture_position, 0.0);
+    if (external_surface.opaque != 0u) {
+        return vec4<f32>(texel.rgb, 1.0);
+    }
+    // Premultiplied texels: as they are for a premultiplied target, straight for an alpha-blended one.
+    if (globals.premultiplied_alpha != 0u || texel.a <= 0.0) {
+        return texel;
+    }
+    return vec4<f32>(texel.rgb / texel.a, texel.a);
+}
