 /// parked in `yieldToDemand` that the demanding waiter had its turn.
 pub fn unlockDemand(self: *State, io: std.Io) void {
     self.mutex.unlock(io);
+    self.finishDemand(io);
+}
+
+/// Keep demand asserted across a host callback that may take the raw mutex
+/// one or more times. Embedded hosts call core surface APIs synchronously on
+/// their UI thread, so those calls need the same handoff guarantee as the
+/// renderer or sustained PTY output can starve keyboard, IME, focus and paste
+/// handling. The core surface takes the mutex itself through `lockDemand`, so
+/// app-thread work outside a guard (the app tick's surface messages) is covered
+/// too; the guard spans paths that relock raw (a full IO mailbox, processOutput).
+pub fn demandGuard(self: *State, io: std.Io) DemandGuard {
+    _ = self.demand.fetchAdd(1, .monotonic);
+    return .{ .state = self, .io = io };
+}
+
+pub const DemandGuard = struct {
+    state: *State,
+    io: std.Io,
+
+    pub fn deinit(self: DemandGuard) void {
+        const prev = self.state.demand.fetchSub(1, .monotonic);
+        assert(prev > 0);
+        self.state.finishDemand(self.io);
+    }
+};
+
+fn finishDemand(self: *State, io: std.Io) void {
     _ = self.handoff_gen.fetchAdd(1, .monotonic);
     io.futexWake(@TypeOf(self.handoff_gen), &self.handoff_gen, 1);
 }
