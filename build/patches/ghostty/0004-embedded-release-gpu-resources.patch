+    /// Free the renderer's GPU resources (the swap chain: render targets,
+    /// font atlas textures, cell and uniform buffers, custom shader
+    /// textures) while the surface is hidden. The renderer releases them
+    /// on occlusion itself only where it draws on its own thread; with
+    /// OpenGL the host draws on the app thread (`must_draw_from_app_thread`),
+    /// so the host calls this instead, on the app thread with the surface's
+    /// GL context current. Safe to repeat; the next draw rebuilds them. It
+    /// touches neither the terminal nor its visibility (`set_occlusion`).
+    export fn ghostty_surface_release_gpu_resources(surface: *Surface) void {
+        surface.core_surface.renderer.releaseGpuResources();
+    }
