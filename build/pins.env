# Native build pins, sourced by scripts/build-ghostty.sh, scripts/build-ghostty-vt.sh, scripts/build-zmx.sh,
# scripts/build-layer-shell.sh, scripts/fetch-wpe.sh, scripts/fetch-fonts.sh and scripts/gen-wpe-bindings.sh.
#
# Every GHOSTTY_* line feeds the libghostty prefix key, every LIBGHOSTTY_VT_* line the libghostty-vt one, every ZMX_*
# line the zmx one, every LAYER_SHELL_* line the gtk4-layer-shell one, every WPE_* line the WPE WebKit one, every
# GIR_* line the gir one and every FONTS_* line the terminal fonts one, so a pin of one build never rebuilds another.
# Each build keeps its own Zig pin, today all 0.16.0: each repository's `minimum_zig_version` at its revision. The
# Zig sums are ziglang.org's (download/index.json) for the release tarballs.

# libghostty at upstream agterm v0.36.0's GHOSTTY_REV (.upstream/agterm scripts/setup.sh, 2026-08-25)
GHOSTTY_REPO="https://github.com/ghostty-org/ghostty"
GHOSTTY_REV="683d8db643b95cf229bfb5fe9fab9ae677920343"
GHOSTTY_ZIG_VERSION="0.16.0"
GHOSTTY_ZIG_SHA256_X86_64="70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00"
GHOSTTY_ZIG_SHA256_AARCH64="ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17"
# the iterm2_themes dependency this Ghostty revision declares in its build.zig.zon
GHOSTTY_THEMES_URL="https://deps.files.ghostty.org/ghostty-themes-release-20260810-152212-0173c3c.tgz"
GHOSTTY_THEMES_SHA256="ea9878471420ee5b12e7f2ff480099c954ea50e573a1bdf83f43e105c9be63f0"
GHOSTTY_THEME_COUNT=602
GHOSTTY_KNOWN_THEMES=("Builtin Dark" "Catppuccin Mocha" "Dracula")

# zmx behind live sessions, upstream's ZMX_REV (.upstream/agterm scripts/setup.sh, v0.8.1, 2026-09-05)
ZMX_REPO="https://github.com/neurosnap/zmx"
ZMX_REV="8bab1f0173b07e79835ea372d749af3dbf0d0842"
ZMX_ZIG_VERSION="0.16.0"
ZMX_ZIG_SHA256_X86_64="70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00"
ZMX_ZIG_SHA256_AARCH64="ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17"

# libghostty-vt, Ghostty's VT library behind its official C API (include/ghostty/vt.h), for the GPUI frontend: a
# second Ghostty pin while both frontends coexist. GHOSTTY_REV moves only with an upstream agterm release and lacks
# the vt API the GPUI build needs (search.h, PROGRAM_STATUS, SEMANTIC_PROMPT, the scrollback use-after-free fix), so
# this one follows ghostty main: 2026-10-13, merge #14691, every build-libghostty-vt* CI job green. No patches. Not
# prefixed GHOSTTY_, which would key the libghostty build on it. A bump regenerates the bindings
# (scripts/gen-ghostty-vt-bindings.sh) and is a change of its own; the two pins become one when libghostty goes away.
# The sha256 is the source archive's (codeload tar.gz of the commit).
LIBGHOSTTY_VT_REPO="https://github.com/ghostty-org/ghostty"
LIBGHOSTTY_VT_REV="81598385d608dda4946093d6d6a234d204a2f225"
LIBGHOSTTY_VT_SHA256="1bb165d1e9458c8694370039cc1a8f2a2958929760bb80f6251499158ad6b694"
LIBGHOSTTY_VT_ZIG_VERSION="0.16.0"
LIBGHOSTTY_VT_ZIG_SHA256_X86_64="70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00"
LIBGHOSTTY_VT_ZIG_SHA256_AARCH64="ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17"

# WPE WebKit, the engine of the GPUI frontend's HTML overlays (WPEPlatform API), at the version its spike ran. Where it
# comes from (README > WPE WebKit): the distro's `wpewebkit` where packaged (a system wpe-webkit-2.0 at least
# WPE_API_VERSION wins, see scripts/pkg-config.sh); on a rootless machine with an Arch-compatible userland, this Arch
# package (archive.archlinux.org keeps it; its pacman signature was checked when pinned) unpacked by
# scripts/fetch-wpe.sh into the vendored prefix, which needs glibc WPE_ARCH_GLIBC; in CI the same package from a
# date-pinned Arch Linux Archive snapshot inside an archlinux container. The bindings' .gir files come from this package
# too (scripts/gen-wpe-bindings.sh). Every WPE_* line feeds the vendored prefix key.
WPE_VERSION="2.54.1"
WPE_API_VERSION="2.54"
WPE_ARCH_PACKAGE_URL="https://archive.archlinux.org/packages/w/wpewebkit/wpewebkit-2.54.1-2-x86_64.pkg.tar.zst"
WPE_ARCH_PACKAGE_SHA256="2279cfe4f842b693625b7ad70b81b13fbee1022bed51f5f6319a76855b9273a9"
WPE_ARCH_GLIBC="2.44"

# gtk-rs `gir`, which generates the WPE -sys crates (scripts/gen-wpe-bindings.sh), at the 0.22 branch commit that
# generated the glib-sys 0.22 the workspace locks, with the gir-files commit glib-sys 0.22.9 was generated from and
# the Soup-3.0.gir soup3-sys 0.9.0 was generated from (soup3-rs branch v0.9). The sha256s are the source archives' and
# the .gir's. Every GIR_* line (and build/patches/gir/) feeds the key of the vendored gir binary.
GIR_REPO="https://github.com/gtk-rs/gir"
GIR_REV="f402b90c8ad678679e40011c008303b53f251619"
GIR_SHA256="3746813b3dbd9fcec47a9ae6c3a2f48bdd7898484f15be3824a21a984f95fb73"
GIR_FILES_REPO="https://github.com/gtk-rs/gir-files"
GIR_FILES_REV="f1b46c29333cc9824088838c68be8e4ad9e26495"
GIR_FILES_SHA256="5c285ecdbb8b677e9447bd127fc56a8e2987689ebb6de798c2d2099ecd8ec968"
GIR_SOUP_URL="https://gitlab.gnome.org/World/Rust/soup3-rs/-/raw/43121bc229b241b6338b62d56be1bdd164d60eea/Soup-3.0.gir"
GIR_SOUP_SHA256="18be1efe2e35df7c4a09f2886c1ad6fe311636eb404f0fb935186b0a771a92a8"

# gtk4-layer-shell, the C library under the quick terminal's layer-shell panel (the `gtk4-layer-shell` crate links
# it): the latest release, built from its tag archive because Ubuntu 24.04 does not package it. Cargo finds the
# prefix through scripts/pkg-config.sh (.cargo/config.toml) and does not see a pin change by itself: after bumping
# these, run `cargo clean -p gtk4-layer-shell-sys` so the link path follows the new prefix.
LAYER_SHELL_REPO="https://github.com/wmww/gtk4-layer-shell"
LAYER_SHELL_VERSION="1.3.0"
LAYER_SHELL_SHA256="1ebb01ab14e98afd1727f68f64981c37bd23305b1f131f5667c02b94cf593192"

# The fonts Ghostty embeds, for the GPUI frontend's terminal (agterm-gpui embeds them at build time): JetBrains Mono,
# the face used when `font-family` is unset, and Symbols Nerd Font, every family's symbol fallback. They are the
# package deps of the Ghostty at LIBGHOSTTY_VT_REV (build.zig.zon `jetbrains_mono`, `nerd_fonts_symbols_only`); the
# sha256s are the archives', whose Zig package hashes (`zig fetch`) equal the ones build.zig.zon pins
# (N-V-__8AAIC5lwAVPJJzxnCAahSvZTIlG-HhtOvnM1uh-66x, N-V-__8AAMVLTABmYkLqhZPLXnMl-KyN38R8UVYqGrxqO26s). JetBrains Mono
# is under the SIL Open Font License 1.1, Symbols Nerd Font under MIT; both licenses are kept in the prefix.
FONTS_JETBRAINS_MONO_URL="https://deps.files.ghostty.org/JetBrainsMono-2.304.tar.gz"
FONTS_JETBRAINS_MONO_SHA256="c57a691e8b82ad098b5963f3959032e4038f391087af7715885ba59046105cc4"
FONTS_NERD_SYMBOLS_URL="https://deps.files.ghostty.org/NerdFontsSymbolsOnly-3.4.0.tar.gz"
FONTS_NERD_SYMBOLS_SHA256="1164d1b956d4bde248d7b2f0998c43cc94f5202431a1564a793895b1e73b0d04"
