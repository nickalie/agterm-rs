# Native build pins, sourced by scripts/build-ghostty.sh, scripts/build-ghostty-vt.sh, scripts/build-zmx.sh and
# scripts/build-layer-shell.sh.
#
# Every GHOSTTY_* line feeds the libghostty prefix key, every LIBGHOSTTY_VT_* line the libghostty-vt one, every ZMX_*
# line the zmx one, every LAYER_SHELL_* line the gtk4-layer-shell one, so a pin of one build never rebuilds another.
# Each build keeps its own Zig pin, today all 0.16.0: each repository's `minimum_zig_version` at its revision. The
# Zig sums are ziglang.org's (download/index.json) for the release tarballs.

# libghostty at upstream agterm v0.36.0's GHOSTTY_REV (.upstream/agterm scripts/setup.sh, 2026-08-25)
GHOSTTY_REPO="https://github.com/ghostty-org/ghostty"
GHOSTTY_REV="683d8db643b95cf229bfb5fe9fab9ae677920343"
GHOSTTY_ZIG_VERSION="0.16.0"
GHOSTTY_ZIG_SHA256_X86_64="70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00"
GHOSTTY_ZIG_SHA256_AARCH64="ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17"
# the iterm2_themes dependency this Ghostty revision declares in its build.zig.zon
GHOSTTY_THEMES_URL="https://deps.files.ghostty.org/ghostty-themes-release-20260810-152212-0173c3c.tgz"
GHOSTTY_THEMES_SHA256="ea9878471420ee5b12e7f2ff480099c954ea50e573a1bdf83f43e105c9be63f0"
GHOSTTY_THEME_COUNT=602
GHOSTTY_KNOWN_THEMES=("Builtin Dark" "Catppuccin Mocha" "Dracula")

# zmx behind live sessions, upstream's ZMX_REV (.upstream/agterm scripts/setup.sh, v0.8.1, 2026-09-05)
ZMX_REPO="https://github.com/neurosnap/zmx"
ZMX_REV="8bab1f0173b07e79835ea372d749af3dbf0d0842"
ZMX_ZIG_VERSION="0.16.0"
ZMX_ZIG_SHA256_X86_64="70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00"
ZMX_ZIG_SHA256_AARCH64="ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17"

# libghostty-vt, Ghostty's VT library behind its official C API (include/ghostty/vt.h), for the GPUI frontend: a
# second Ghostty pin while both frontends coexist. GHOSTTY_REV moves only with an upstream agterm release and lacks
# the vt API the GPUI build needs (search.h, PROGRAM_STATUS, SEMANTIC_PROMPT, the scrollback use-after-free fix), so
# this one follows ghostty main: 2026-10-13, merge #14691, every build-libghostty-vt* CI job green. No patches. Not
# prefixed GHOSTTY_, which would key the libghostty build on it. A bump regenerates the bindings
# (scripts/gen-ghostty-vt-bindings.sh) and is a change of its own; the two pins become one when libghostty goes away.
# The sha256 is the source archive's (codeload tar.gz of the commit).
LIBGHOSTTY_VT_REPO="https://github.com/ghostty-org/ghostty"
LIBGHOSTTY_VT_REV="81598385d608dda4946093d6d6a234d204a2f225"
LIBGHOSTTY_VT_SHA256="1bb165d1e9458c8694370039cc1a8f2a2958929760bb80f6251499158ad6b694"
LIBGHOSTTY_VT_ZIG_VERSION="0.16.0"
LIBGHOSTTY_VT_ZIG_SHA256_X86_64="70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00"
LIBGHOSTTY_VT_ZIG_SHA256_AARCH64="ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17"

# gtk4-layer-shell, the C library under the quick terminal's layer-shell panel (the `gtk4-layer-shell` crate links
# it): the latest release, built from its tag archive because Ubuntu 24.04 does not package it. Cargo finds the
# prefix through scripts/pkg-config.sh (.cargo/config.toml) and does not see a pin change by itself: after bumping
# these, run `cargo clean -p gtk4-layer-shell-sys` so the link path follows the new prefix.
LAYER_SHELL_REPO="https://github.com/wmww/gtk4-layer-shell"
LAYER_SHELL_VERSION="1.3.0"
LAYER_SHELL_SHA256="1ebb01ab14e98afd1727f68f64981c37bd23305b1f131f5667c02b94cf593192"
