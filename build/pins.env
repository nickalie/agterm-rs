# Native build pins, sourced by scripts/build-ghostty.sh and scripts/build-zmx.sh.
#
# Every GHOSTTY_* line feeds the libghostty prefix key, every ZMX_* line the zmx one, so a zmx pin never
# rebuilds libghostty and the other way round. The two Zig compilers are not shared: libghostty at
# GHOSTTY_REV builds with 0.15.2, zmx with its own `minimum_zig_version`. The Zig sums are ziglang.org's
# (download/index.json) for the release tarballs.

# libghostty, from ../agterm-linux linux/ghostty-resources.env
GHOSTTY_REPO="https://github.com/ghostty-org/ghostty"
GHOSTTY_REV="11b9a6ef17e21b89e2ef14dd786992cc5577b69b"
GHOSTTY_ZIG_VERSION="0.15.2"
GHOSTTY_ZIG_SHA256_X86_64="02aa270f183da276e5b5920b1dac44a63f1a49e55050ebde3aecc9eb82f93239"
GHOSTTY_ZIG_SHA256_AARCH64="958ed7d1e00d0ea76590d27666efbf7a932281b3d7ba0c6b01b0ff26498f667f"
# the iterm2_themes dependency this Ghostty revision declares in its build.zig.zon
GHOSTTY_THEMES_URL="https://deps.files.ghostty.org/ghostty-themes-release-20260629-161812-8c97c3c.tgz"
GHOSTTY_THEMES_SHA256="aae3023ec6d521e2eacc8576a248d10d94cac40e9876451262ec660477f7c4c8"
GHOSTTY_THEME_COUNT=574
GHOSTTY_KNOWN_THEMES=("Builtin Dark" "Catppuccin Mocha" "Dracula")

# zmx behind live sessions, from ../agterm-linux linux/zmx.env (v0.8.1, 2026-09-05)
ZMX_REPO="https://github.com/neurosnap/zmx"
ZMX_REV="8bab1f0173b07e79835ea372d749af3dbf0d0842"
ZMX_ZIG_VERSION="0.16.0"
ZMX_ZIG_SHA256_X86_64="70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00"
ZMX_ZIG_SHA256_AARCH64="ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17"
