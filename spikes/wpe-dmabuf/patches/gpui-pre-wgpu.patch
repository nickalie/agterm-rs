diff -ruN a/src/external_surface.rs b/src/external_surface.rs
--- a/src/external_surface.rs	1970-01-01 02:00:00.000000000 +0200
+++ b/src/external_surface.rs	2026-10-14 22:55:56.414332456 +0300
@@ -0,0 +1,412 @@
+//! Spike patch (agterm-rs wpe-dmabuf): draws `ExternalSurface` frames — dmabufs imported zero-copy through
+//! wgpu-hal Vulkan, and CPU pixels uploaded by damaged rects into a renderer-owned texture.
+
+use anyhow::{Context as _, Result, bail};
+use collections::FxHashMap;
+use gpui::{DmaBufFrame, ExternalSurface, PixelFrame};
+use std::os::fd::{BorrowedFd, IntoRawFd as _};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+const DRM_FORMAT_ARGB8888: u32 = u32::from_le_bytes(*b"AR24");
+const DRM_FORMAT_XRGB8888: u32 = u32::from_le_bytes(*b"XR24");
+const DRM_FORMAT_ABGR8888: u32 = u32::from_le_bytes(*b"AB24");
+const DRM_FORMAT_XBGR8888: u32 = u32::from_le_bytes(*b"XB24");
+
+/// Counters the spike reads back.
+pub static DMABUF_IMPORTS: AtomicU64 = AtomicU64::new(0);
+pub static DMABUF_IMPORT_FAILURES: AtomicU64 = AtomicU64::new(0);
+pub static PIXEL_UPLOAD_BYTES: AtomicU64 = AtomicU64::new(0);
+pub static EXTERNAL_DRAWS: AtomicU64 = AtomicU64::new(0);
+
+/// With `SPIKE_READBACK` set, the center pixel (B, G, R, A packed little-endian) of the last dmabuf frame drawn,
+/// read back from the imported texture: proves the import samples the right memory with the right layout.
+pub static LAST_CENTER_PIXEL: AtomicU64 = AtomicU64::new(u64::MAX);
+
+struct Imported {
+    texture: wgpu::Texture,
+    view: wgpu::TextureView,
+    last_used: u64,
+}
+
+struct PixelTexture {
+    texture: wgpu::Texture,
+    view: wgpu::TextureView,
+    width: u32,
+    height: u32,
+    bgra: bool,
+    serial: u64,
+    last_used: u64,
+}
+
+#[derive(Default)]
+pub(crate) struct ExternalSurfaces {
+    generation: u64,
+    frame: u64,
+    imported: FxHashMap<u64, Imported>,
+    pixels: FxHashMap<u64, PixelTexture>,
+    /// One bind group per `scene.surfaces` entry, in scene order; `None` when the frame could not be drawn.
+    pub(crate) draws: Vec<Option<wgpu::BindGroup>>,
+}
+
+impl ExternalSurfaces {
+    pub(crate) fn prepare(
+        &mut self,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        layout: &wgpu::BindGroupLayout,
+        sampler: &wgpu::Sampler,
+        surfaces: &[gpui::PaintSurface],
+        params: impl Fn(&gpui::PaintSurface) -> [u8; 32],
+    ) {
+        use wgpu::util::DeviceExt as _;
+        READBACK_QUEUE.with(|q| *q.borrow_mut() = Some(queue.clone()));
+        self.frame += 1;
+        self.draws.clear();
+        for surface in surfaces {
+            let view = match &surface.source {
+                ExternalSurface::DmaBuf(frame) => self.dmabuf_view(device, frame),
+                ExternalSurface::Pixels(frame) => Some(self.pixel_view(device, queue, frame)),
+            };
+            let Some(view) = view else {
+                self.draws.push(None);
+                continue;
+            };
+            let uniform = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                label: Some("external_surface_params"),
+                contents: &params(surface),
+                usage: wgpu::BufferUsages::UNIFORM,
+            });
+            let bind_group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("external_surface"),
+                layout,
+                entries: &[
+                    wgpu::BindGroupEntry { binding: 0, resource: uniform.as_entire_binding() },
+                    wgpu::BindGroupEntry { binding: 1, resource: wgpu::BindingResource::TextureView(&view) },
+                    wgpu::BindGroupEntry { binding: 2, resource: wgpu::BindingResource::TextureView(&view) },
+                    wgpu::BindGroupEntry { binding: 3, resource: wgpu::BindingResource::Sampler(sampler) },
+                ],
+            });
+            EXTERNAL_DRAWS.fetch_add(1, Ordering::Relaxed);
+            self.draws.push(Some(bind_group));
+        }
+        // Imports and pixel textures not drawn for a while belong to buffers the producer dropped.
+        let frame = self.frame;
+        self.imported.retain(|_, entry| frame - entry.last_used < 120);
+        self.pixels.retain(|_, entry| frame - entry.last_used < 120);
+    }
+
+    fn dmabuf_view(&mut self, device: &wgpu::Device, frame: &DmaBufFrame) -> Option<wgpu::TextureView> {
+        if frame.generation != self.generation {
+            self.generation = frame.generation;
+            self.imported.clear();
+        }
+        if let Some(entry) = self.imported.get_mut(&frame.id) {
+            entry.last_used = self.frame;
+            if std::env::var_os("SPIKE_READBACK").is_some() {
+                readback_center(device, &entry.texture);
+            }
+            return Some(entry.view.clone());
+        }
+        match import_dmabuf(device, frame) {
+            Ok(texture) => {
+                DMABUF_IMPORTS.fetch_add(1, Ordering::Relaxed);
+                let view = texture.create_view(&wgpu::TextureViewDescriptor::default());
+                if std::env::var_os("SPIKE_READBACK").is_some() {
+                    readback_center(device, &texture);
+                }
+                self.imported.insert(
+                    frame.id,
+                    Imported { texture, view: view.clone(), last_used: self.frame },
+                );
+                Some(view)
+            }
+            Err(error) => {
+                if DMABUF_IMPORT_FAILURES.fetch_add(1, Ordering::Relaxed) < 5 {
+                    log::error!("dmabuf import failed: {error:#}");
+                }
+                None
+            }
+        }
+    }
+
+    fn pixel_view(&mut self, device: &wgpu::Device, queue: &wgpu::Queue, frame: &PixelFrame) -> wgpu::TextureView {
+        let current = self.frame;
+        let stale = self.pixels.get(&frame.texture_key).is_none_or(|entry| {
+            entry.width != frame.width || entry.height != frame.height || entry.bgra != frame.bgra
+        });
+        if stale {
+            let format = if frame.bgra { wgpu::TextureFormat::Bgra8Unorm } else { wgpu::TextureFormat::Rgba8Unorm };
+            let texture = device.create_texture(&wgpu::TextureDescriptor {
+                label: Some("external_pixels"),
+                size: wgpu::Extent3d { width: frame.width, height: frame.height, depth_or_array_layers: 1 },
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format,
+                usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+                view_formats: &[],
+            });
+            let view = texture.create_view(&wgpu::TextureViewDescriptor::default());
+            self.pixels.insert(
+                frame.texture_key,
+                PixelTexture {
+                    texture,
+                    view,
+                    width: frame.width,
+                    height: frame.height,
+                    bgra: frame.bgra,
+                    serial: u64::MAX,
+                    last_used: current,
+                },
+            );
+        }
+        let entry = self.pixels.get_mut(&frame.texture_key).expect("inserted above");
+        entry.last_used = current;
+        if entry.serial != frame.serial {
+            // A new texture has no content yet: upload the whole frame the first time.
+            let full = [[0, 0, frame.width, frame.height]];
+            let rects: &[[u32; 4]] = if stale || frame.damage.is_empty() { &full } else { &frame.damage };
+            for &[x, y, w, h] in rects {
+                let (x, y) = (x.min(frame.width), y.min(frame.height));
+                let (w, h) = (w.min(frame.width - x), h.min(frame.height - y));
+                if w == 0 || h == 0 {
+                    continue;
+                }
+                let offset = y as usize * frame.stride as usize + x as usize * 4;
+                let end = (y + h - 1) as usize * frame.stride as usize + (x + w) as usize * 4;
+                queue.write_texture(
+                    wgpu::TexelCopyTextureInfo {
+                        texture: &entry.texture,
+                        mip_level: 0,
+                        origin: wgpu::Origin3d { x, y, z: 0 },
+                        aspect: wgpu::TextureAspect::All,
+                    },
+                    &frame.data[offset..end],
+                    wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(frame.stride), rows_per_image: Some(h) },
+                    wgpu::Extent3d { width: w, height: h, depth_or_array_layers: 1 },
+                );
+                PIXEL_UPLOAD_BYTES.fetch_add(u64::from(w) * u64::from(h) * 4, Ordering::Relaxed);
+            }
+            entry.serial = frame.serial;
+        }
+        entry.view.clone()
+    }
+}
+
+fn import_dmabuf(device: &wgpu::Device, frame: &DmaBufFrame) -> Result<wgpu::Texture> {
+    use ash::vk;
+    use wgpu::hal::{self, vulkan};
+
+    let (vk_format, format) = match frame.fourcc {
+        DRM_FORMAT_ARGB8888 | DRM_FORMAT_XRGB8888 => (vk::Format::B8G8R8A8_UNORM, wgpu::TextureFormat::Bgra8Unorm),
+        DRM_FORMAT_ABGR8888 | DRM_FORMAT_XBGR8888 => (vk::Format::R8G8B8A8_UNORM, wgpu::TextureFormat::Rgba8Unorm),
+        other => bail!("unsupported fourcc {:?}", other.to_le_bytes().map(char::from)),
+    };
+    // Several memory planes (e.g. Intel CCS: main + aux + clear color) are imported as one non-disjoint image
+    // when they live in one buffer object, which is what WebKit's GBM allocations give.
+    if frame.planes.is_empty() || frame.planes.len() > 4 {
+        bail!("{} memory planes", frame.planes.len());
+    }
+    if frame.planes.len() > 1 && !planes_share_buffer(&frame.planes) {
+        bail!("{} memory planes in separate buffers (disjoint import not implemented)", frame.planes.len());
+    }
+    let hal_device = unsafe { device.as_hal::<vulkan::Api>() }.context("the device is not Vulkan")?;
+    let raw = hal_device.raw_device();
+    let instance = hal_device.shared_instance().raw_instance();
+
+    let plane_layouts: Vec<vk::SubresourceLayout> = frame
+        .planes
+        .iter()
+        .map(|plane| vk::SubresourceLayout {
+            offset: u64::from(plane.offset),
+            size: 0,
+            row_pitch: u64::from(plane.stride),
+            array_pitch: 0,
+            depth_pitch: 0,
+        })
+        .collect();
+    let mut modifier_info = vk::ImageDrmFormatModifierExplicitCreateInfoEXT::default()
+        .drm_format_modifier(frame.modifier)
+        .plane_layouts(&plane_layouts);
+    let mut external_info =
+        vk::ExternalMemoryImageCreateInfo::default().handle_types(vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT);
+    let image_info = vk::ImageCreateInfo::default()
+        .image_type(vk::ImageType::TYPE_2D)
+        .format(vk_format)
+        .extent(vk::Extent3D { width: frame.width, height: frame.height, depth: 1 })
+        .mip_levels(1)
+        .array_layers(1)
+        .samples(vk::SampleCountFlags::TYPE_1)
+        .tiling(vk::ImageTiling::DRM_FORMAT_MODIFIER_EXT)
+        .usage(vk::ImageUsageFlags::SAMPLED | vk::ImageUsageFlags::TRANSFER_SRC)
+        .sharing_mode(vk::SharingMode::EXCLUSIVE)
+        .initial_layout(vk::ImageLayout::UNDEFINED)
+        .push_next(&mut external_info)
+        .push_next(&mut modifier_info);
+    let image = unsafe { raw.create_image(&image_info, None) }.context("vkCreateImage")?;
+
+    let fd = unsafe { BorrowedFd::borrow_raw(frame.planes[0].fd) }
+        .try_clone_to_owned()
+        .context("dup dmabuf fd")?
+        .into_raw_fd();
+    let fd_device = ash::khr::external_memory_fd::Device::new(instance, raw);
+    let mut fd_props = vk::MemoryFdPropertiesKHR::default();
+    let memory = (|| -> Result<vk::DeviceMemory> {
+        unsafe {
+            fd_device.get_memory_fd_properties(vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT, fd, &mut fd_props)
+        }
+        .context("vkGetMemoryFdPropertiesKHR")?;
+        let requirements = unsafe { raw.get_image_memory_requirements(image) };
+        let type_bits = requirements.memory_type_bits & fd_props.memory_type_bits;
+        if type_bits == 0 {
+            bail!("no memory type fits the dmabuf");
+        }
+        let mut import = vk::ImportMemoryFdInfoKHR::default()
+            .handle_type(vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT)
+            .fd(fd);
+        let mut dedicated = vk::MemoryDedicatedAllocateInfo::default().image(image);
+        let alloc = vk::MemoryAllocateInfo::default()
+            .allocation_size(requirements.size)
+            .memory_type_index(type_bits.trailing_zeros())
+            .push_next(&mut import)
+            .push_next(&mut dedicated);
+        unsafe { raw.allocate_memory(&alloc, None) }.context("vkAllocateMemory (dmabuf import)")
+    })();
+    let memory = match memory {
+        Ok(memory) => memory,
+        Err(error) => {
+            unsafe {
+                libc_close(fd);
+                raw.destroy_image(image, None);
+            }
+            return Err(error);
+        }
+    };
+    if let Err(error) = unsafe { raw.bind_image_memory(image, memory, 0) } {
+        unsafe {
+            raw.free_memory(memory, None);
+            raw.destroy_image(image, None);
+        }
+        bail!("vkBindImageMemory: {error}");
+    }
+
+    let size = wgpu::Extent3d { width: frame.width, height: frame.height, depth_or_array_layers: 1 };
+    let hal_desc = hal::TextureDescriptor {
+        label: Some("dmabuf"),
+        size,
+        mip_level_count: 1,
+        sample_count: 1,
+        dimension: wgpu::TextureDimension::D2,
+        format,
+        usage: wgpu::TextureUses::RESOURCE | wgpu::TextureUses::COPY_SRC,
+        memory_flags: hal::MemoryFlags::empty(),
+        view_formats: vec![],
+    };
+    let hal_texture =
+        unsafe { hal_device.texture_from_raw(image, &hal_desc, None, vulkan::TextureMemory::Dedicated(memory)) };
+    drop(hal_device);
+    Ok(unsafe {
+        device.create_texture_from_hal::<vulkan::Api>(
+            hal_texture,
+            &wgpu::TextureDescriptor {
+                label: Some("dmabuf"),
+                size,
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format,
+                usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_SRC,
+                view_formats: &[],
+            },
+        )
+    })
+}
+
+/// Copies the center texel to a buffer and waits for it (check mode only: it stalls the frame).
+fn readback_center(device: &wgpu::Device, texture: &wgpu::Texture) {
+    let queue = READBACK_QUEUE.with(|q| q.borrow().clone());
+    let Some(queue) = queue else { return };
+    let buffer = device.create_buffer(&wgpu::BufferDescriptor {
+        label: Some("readback"),
+        size: 256,
+        usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+        mapped_at_creation: false,
+    });
+    let mut encoder = device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Some("readback") });
+    encoder.copy_texture_to_buffer(
+        wgpu::TexelCopyTextureInfo {
+            texture,
+            mip_level: 0,
+            origin: wgpu::Origin3d { x: texture.width() / 2, y: texture.height() / 2, z: 0 },
+            aspect: wgpu::TextureAspect::All,
+        },
+        wgpu::TexelCopyBufferInfo {
+            buffer: &buffer,
+            layout: wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(256), rows_per_image: Some(1) },
+        },
+        wgpu::Extent3d { width: 1, height: 1, depth_or_array_layers: 1 },
+    );
+    queue.submit(Some(encoder.finish()));
+    buffer.slice(..4).map_async(wgpu::MapMode::Read, |_| {});
+    let _ = device.poll(wgpu::PollType::wait_indefinitely());
+    let texel = buffer.slice(..4).get_mapped_range();
+    LAST_CENTER_PIXEL.store(u64::from(u32::from_le_bytes([texel[0], texel[1], texel[2], texel[3]])), Ordering::Relaxed);
+}
+
+thread_local! {
+    pub(crate) static READBACK_QUEUE: std::cell::RefCell<Option<wgpu::Queue>> = const { std::cell::RefCell::new(None) };
+}
+
+fn planes_share_buffer(planes: &[gpui::DmaBufPlane]) -> bool {
+    use std::os::unix::fs::MetadataExt as _;
+    let inode = |fd: i32| {
+        let fd = unsafe { BorrowedFd::borrow_raw(fd) }.try_clone_to_owned().ok()?;
+        std::fs::File::from(fd).metadata().ok().map(|m| (m.dev(), m.ino()))
+    };
+    let first = inode(planes[0].fd);
+    first.is_some() && planes.iter().all(|plane| inode(plane.fd) == first)
+}
+
+unsafe fn libc_close(fd: i32) {
+    unsafe extern "C" {
+        fn close(fd: i32) -> i32;
+    }
+    unsafe { close(fd) };
+}
+
+/// Opens the adapter as a Vulkan device with `VK_EXT_image_drm_format_modifier` added to wgpu's extensions;
+/// `None` when the adapter is not Vulkan or lacks the extension (the caller falls back to a plain device).
+pub(crate) fn open_vulkan_device_with_dmabuf(
+    adapter: &wgpu::Adapter,
+    desc: &wgpu::DeviceDescriptor<'_>,
+) -> Option<(wgpu::Device, wgpu::Queue)> {
+    use wgpu::hal::vulkan;
+    let extension = ash::ext::image_drm_format_modifier::NAME;
+    let open = {
+        let hal_adapter = unsafe { adapter.as_hal::<vulkan::Api>() }?;
+        let instance = hal_adapter.shared_instance().raw_instance();
+        let properties =
+            unsafe { instance.enumerate_device_extension_properties(hal_adapter.raw_physical_device()) }.ok()?;
+        if !properties.iter().any(|p| p.extension_name_as_c_str() == Ok(extension)) {
+            log::warn!("VK_EXT_image_drm_format_modifier unsupported: dmabuf import disabled");
+            return None;
+        }
+        let callback: Box<vulkan::CreateDeviceCallback<'_>> = Box::new(move |args| {
+            if !args.extensions.contains(&extension) {
+                args.extensions.push(extension);
+            }
+        });
+        unsafe {
+            hal_adapter.open_with_callback(
+                desc.required_features,
+                &desc.required_limits,
+                &desc.memory_hints,
+                Some(callback),
+            )
+        }
+        .map_err(|error| log::warn!("open_with_callback failed: {error}"))
+        .ok()?
+    };
+    let device = unsafe { adapter.create_device_from_hal::<vulkan::Api>(open, desc) };
+    device.map_err(|error| log::warn!("create_device_from_hal failed: {error}")).ok()
+}
