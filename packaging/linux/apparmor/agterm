# This profile allows everything and only exists to give the
# application a name instead of having the label "unconfined"
#
# agterm's HTML overlays run in WebKit (WebKitGTK in the GTK build, WPE WebKit
# in the GPUI build), whose web process starts inside a bubblewrap sandbox that
# needs an unprivileged user namespace. Ubuntu 23.10+
# (kernel.apparmor_restrict_unprivileged_userns=1) grants one only to a program
# whose profile carries `userns`, as the profiles it ships for its own WebKitGTK
# apps (epiphany, devhelp) do. bwrap, exec'd by agterm with no profile of its
# own, stays in the profile of the binary that started it. One profile per
# binary while both frontends coexist; scripts/install-apparmor-profile.sh fills
# in the paths.

abi <abi/4.0>,
include <tunables/global>

profile agterm "@AGTERM_BIN@" flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/agterm>
}

profile agterm-gpui "@AGTERM_GPUI_BIN@" flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/agterm-gpui>
}
